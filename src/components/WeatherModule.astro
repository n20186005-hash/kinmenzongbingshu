---
import {
  getWeatherSnapshot,
  weatherCodeInfo,
  buildAdvice,
  adviceFactsFromSnapshot,
  adviceLocale,
  weatherChips,
  type WeatherIcon,
} from '../lib/weather';
import { renderAdviceHtml, renderAlertsHtml, renderChipsHtml, type AdviceLabels } from '../lib/weather-ui';
import { getLocaleFromPath, type Locale } from '../i18n/config';
import { attraction } from '../data/site';

interface Props {
  variant?: 'full' | 'compact';
  class?: string;
  id?: string;
  heading?: string;
}

const { variant = 'full', class: className = '', id = 'weather', heading } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname) as Locale;

const snapshot = await getWeatherSnapshot();

/* --- 圖示（內嵌 SVG，不使用表情符號） --- */
const ICONS: Record<WeatherIcon, string> = {
  clear:
    '<circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6M5.3 5.3l1.9 1.9M16.8 16.8l1.9 1.9M18.7 5.3l-1.9 1.9M7.2 16.8l-1.9 1.9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>',
  partly:
    '<circle cx="9" cy="9.2" r="3.4" fill="currentColor"/><path d="M9 2.4v2.1M2.4 9.2h2.1M4.3 4.5l1.5 1.5M13.7 4.5l-1.5 1.5M4.3 13.9l1.5-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M9.5 19.6h9.2a3.4 3.4 0 0 0 .3-6.8 5 5 0 0 0-9.3-1.2 3.9 3.9 0 0 0-.2 8z" fill="currentColor" opacity="0.55"/>',
  cloud:
    '<path d="M7.2 19.4h10.4a4 4 0 0 0 .4-8 5.8 5.8 0 0 0-10.9-1.5 4.6 4.6 0 0 0 .1 9.5z" fill="currentColor"/>',
  fog:
    '<path d="M7.4 13.6h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor" opacity="0.7"/><path d="M4 17.2h16M6.5 20.4h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>',
  drizzle:
    '<path d="M7.4 13.4h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor" opacity="0.7"/><path d="M8.6 16.4l-.7 2.4M12 16.4l-.7 2.4M15.4 16.4l-.7 2.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>',
  rain:
    '<path d="M7.4 12.8h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor" opacity="0.7"/><path d="M8.4 15.4l-1.3 4M12 15.4l-1.3 4M15.6 15.4l-1.3 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"/>',
  shower:
    '<path d="M6.6 11.6h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor"/><path d="M7.4 14.6l-1.6 5M11.4 14.6l-1.6 5M15.4 14.6l-1.6 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"/>',
  thunder:
    '<path d="M7.4 12.6h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor" opacity="0.7"/><path d="M13.2 14.4l-3 4.2h2.6l-1.1 4 3.6-5h-2.5z" fill="currentColor"/>',
  snow:
    '<path d="M7.4 12.6h9.4a3.5 3.5 0 0 0 .3-7 5.2 5.2 0 0 0-9.8-1.3 4 4 0 0 0 .1 8.3z" fill="currentColor" opacity="0.7"/><path d="M8.6 16.4h.01M12 16.4h.01M15.4 16.4h.01M10.3 19.8h.01M13.7 19.8h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"/>',
};

const COPY = {
  'zh-Hant-TW': {
    eyebrow: '即時天氣',
    title: '金城後浦即時天氣與未來 7 日預報',
    intro: '不只看溫度：這裡把氣溫、體感、紫外線、風勢與降雨機率直接轉成「今天怎麼穿、怎麼排、帶什麼」。',
    now: '目前天氣',
    feels: '體感',
    humidity: '相對濕度',
    wind: '風速',
    precip: '降雨量',
    next7: '未來 7 日',
    rainChance: '降雨機率',
    sunrise: '日出',
    sunset: '日落',
    updated: '更新於',
    refresh: '重新整理',
    loading: '正在取得最新天氣…',
    unavailable: '目前無法取得即時天氣資料。',
    fallbackHint: '以下為季節概況，實際天氣請以中央氣象署發布資訊為準。',
    umbrella: ['不必帶傘', '建議帶摺傘備用', '建議帶傘', '務必攜帶雨具'],
    adviceTitle: '今天怎麼安排',
    labels: { alertTitle: '風險提醒', dress: '出行穿搭', plan: '遊玩安排', pack: '隨身物品' } as AdviceLabels,
    disclaimer:
      '預報為模式推估值，沿海與山區風速常較市區更強；颱風、濃霧與強降雨期間，請以中央氣象署警特報與航班船班公告為準。',
    windUnit: '公里/小時',
  },
  'zh-Hans': {
    eyebrow: '实时天气',
    title: '金城后浦实时天气与未来 7 日预报',
    intro: '不只看温度：这里把气温、体感、紫外线、风势与降雨概率直接转成「今天怎么穿、怎么排、带什么」。',
    now: '当前天气',
    feels: '体感',
    humidity: '相对湿度',
    wind: '风速',
    precip: '降雨量',
    next7: '未来 7 日',
    rainChance: '降雨概率',
    sunrise: '日出',
    sunset: '日落',
    updated: '更新于',
    refresh: '重新整理',
    loading: '正在获取最新天气…',
    unavailable: '暂时无法取得实时天气资料。',
    fallbackHint: '以下为季节概况，实际天气请以中央气象署发布资讯为准。',
    umbrella: ['不必带伞', '建议带折叠伞备用', '建议带伞', '务必携带雨具'],
    adviceTitle: '今天怎么安排',
    labels: { alertTitle: '风险提醒', dress: '出行穿搭', plan: '游玩安排', pack: '随身物品' } as AdviceLabels,
    disclaimer:
      '预报为模式推估值，沿海与山区风速常较市区更强；台风、浓雾与强降雨期间，请以中央气象署警报与航班船班公告为准。',
    windUnit: '公里/小时',
  },
  en: {
    eyebrow: 'Live weather',
    title: 'Jincheng Houpu live weather and 7-day forecast',
    intro: 'More than a temperature: temperature, feels-like, UV, wind and rain chance are turned straight into what to wear, how to plan and what to pack today.',
    now: 'Now',
    feels: 'Feels like',
    humidity: 'Humidity',
    wind: 'Wind',
    precip: 'Rainfall',
    next7: 'Next 7 days',
    rainChance: 'Rain chance',
    sunrise: 'Sunrise',
    sunset: 'Sunset',
    updated: 'Updated',
    refresh: 'Refresh',
    loading: 'Fetching the latest conditions…',
    unavailable: 'Live weather is temporarily unavailable.',
    fallbackHint: 'Seasonal averages are shown below; always check official warnings before travelling.',
    umbrella: ['No umbrella needed', 'A compact umbrella may help', 'Bring an umbrella', 'Rain gear is essential'],
    adviceTitle: 'How to plan today',
    labels: { alertTitle: 'Weather alerts', dress: 'What to wear', plan: 'What to plan', pack: 'What to pack' } as AdviceLabels,
    disclaimer:
      'Forecasts are model estimates and coastal or hill wind is usually stronger than inland. During typhoons, dense fog or heavy rain, follow official warnings and airline or ferry notices.',
    windUnit: 'km/h',
  },
} as const;

const copy = COPY[locale === 'en' ? 'en' : locale === 'zh-Hans' ? 'zh-Hans' : 'zh-Hant-TW'];

const localeTag = locale === 'en' ? 'en-US' : locale === 'zh-Hans' ? 'zh-Hans-CN' : 'zh-Hant-TW';
const adviceLocaleTag = adviceLocale(locale === 'en' ? 'en' : locale === 'zh-Hans' ? 'zh-Hans' : 'zh-Hant');

const dayLabel = (date: string) =>
  new Intl.DateTimeFormat(localeTag, { weekday: 'short', month: 'numeric', day: 'numeric' }).format(
    new Date(`${date}T12:00:00+08:00`),
  );

const timeLabel = (iso: string) => {
  if (!iso) return '—';
  const parsed = new Date(iso);
  if (Number.isNaN(parsed.getTime())) return iso.slice(11, 16);
  return new Intl.DateTimeFormat(localeTag, {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Taipei',
  }).format(parsed);
};

const initial = snapshot;
const currentInfo = initial ? weatherCodeInfo(initial.current.weatherCode) : null;
const todayInfo = initial?.daily[0] ? weatherCodeInfo(initial.daily[0].code) : null;
const umbrellaIndex = todayInfo ? todayInfo.umbrella : 1;

const facts = initial ? adviceFactsFromSnapshot(initial) : null;
const advice = facts ? buildAdvice(facts, adviceLocaleTag) : null;
const chips = facts ? weatherChips(facts, adviceLocaleTag) : [];

const alertsHtml = advice ? renderAlertsHtml(advice, copy.labels) : '';
const adviceHtml = advice ? renderAdviceHtml(advice, copy.labels) : '';
const chipsHtml = renderChipsHtml(chips);

const sectionTitle = heading ?? copy.title;
const rounded = (value: number) => Math.round(value);

const config = {
  id,
  latitude: attraction.coordinates.lat,
  longitude: attraction.coordinates.lng,
  timezone: 'Asia/Taipei',
  locale: localeTag,
  icuLocale: locale === 'en' ? 'en' : locale === 'zh-Hans' ? 'zh-Hans' : 'zh-Hant',
  adviceLocale: adviceLocaleTag,
  labels: copy.labels,
  copy: {
    feels: copy.feels,
    humidity: copy.humidity,
    wind: copy.wind,
    precip: copy.precip,
    rainChance: copy.rainChance,
    umbrella: copy.umbrella as unknown as string[],
    updated: copy.updated,
    loading: copy.loading,
    unavailable: copy.unavailable,
    windUnit: copy.windUnit,
    refresh: copy.refresh,
  },
  icons: ICONS,
};
---

<section
  class={`container-page ${className}`}
  id={id}
  aria-labelledby={`${id}-title`}
  data-wx-scope
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-2 font-serif text-2xl text-[var(--color-wood)] sm:text-3xl">
        {sectionTitle}
      </h2>
      {variant === 'full' && <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-wood-soft)]">{copy.intro}</p>}
    </div>
    <div class="flex items-center gap-3">
      <p class="text-xs text-[var(--color-slate)]" data-wx="updated-line">
        {initial ? `${copy.updated} ${timeLabel(initial.fetchedAt)}` : copy.loading}
      </p>
      <button
        type="button"
        class="btn btn-secondary px-3 py-1.5 text-xs"
        data-wx-refresh
        aria-label={copy.refresh}
      >
        {copy.refresh}
      </button>
    </div>
  </div>

  <!-- 風險提醒：有觸發條件才顯示，置於最上方 -->
  <div class="mt-5" data-wx-alerts set:html={alertsHtml} />

  {chipsHtml && <div class="mt-5" data-wx-chips set:html={chipsHtml} />}

  <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,19rem)_1fr]" data-wx-body>
    <!-- 目前天氣 -->
    <div class="card overflow-hidden p-0">
      <div class="bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] px-6 py-6 text-[#f7f1e6]">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs tracking-wide text-white/70">{copy.now}</p>
            <p class="mt-1 font-serif text-5xl leading-none" data-wx="temp">
              {initial ? `${rounded(initial.current.temperature)}°` : '--'}
            </p>
            <p class="mt-2 text-sm" data-wx="label">
              {initial
                ? locale === 'en'
                  ? currentInfo!.en
                  : locale === 'zh-Hans'
                    ? currentInfo!.hans
                    : currentInfo!.zh
                : '—'}
            </p>
          </div>
          <span class="shrink-0 text-white/90" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="56"
              height="56"
              data-wx-icon
              set:html={ICONS[initial ? currentInfo!.icon : 'partly']}
            />
          </span>
        </div>
      </div>
      <dl class="divide-y divide-[var(--color-slate-line)] px-6 text-sm" data-wx="metrics">
        <div class="flex items-center justify-between py-3">
          <dt class="text-[var(--color-slate)]">{copy.feels}</dt>
          <dd class="font-semibold text-[var(--color-wood)]" data-wx="feels">
            {initial ? `${rounded(initial.current.apparent)}°C` : '--'}
          </dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-[var(--color-slate)]">{copy.humidity}</dt>
          <dd class="font-semibold text-[var(--color-wood)]" data-wx="humidity">
            {initial ? `${rounded(initial.current.humidity)}%` : '--'}
          </dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-[var(--color-slate)]">{copy.wind}</dt>
          <dd class="font-semibold text-[var(--color-wood)]" data-wx="wind">
            {initial ? `${Math.round(initial.current.windSpeed)} ${copy.windUnit}` : '--'}
          </dd>
        </div>
        <div class="flex items-center justify-between py-3">
          <dt class="text-[var(--color-slate)]">{copy.precip}</dt>
          <dd class="font-semibold text-[var(--color-wood)]" data-wx="precip">
            {initial ? `${initial.current.precipitation.toFixed(1)} mm` : '--'}
          </dd>
        </div>
      </dl>
      <p
        class="border-t border-[var(--color-slate-line)] bg-[var(--color-paper-deep)] px-6 py-4 text-sm font-semibold text-[var(--color-brick)]"
        data-wx="umbrella"
      >
        {copy.umbrella[umbrellaIndex]}
      </p>
    </div>

    <!-- 7 日預報 -->
    <div class="card p-0">
      <p class="border-b border-[var(--color-slate-line)] px-5 py-4 text-sm font-semibold text-[var(--color-wood)]">
        {copy.next7}
      </p>
      <ul class="divide-y divide-[var(--color-slate-line)]" data-wx-daily>
        {initial?.daily.map((day, index) => {
          const info = weatherCodeInfo(day.code);
          const chance = day.precipProbability;
          return (
            <li class="flex items-center gap-3 px-5 py-3 text-sm" data-day={day.date}>
              <span class="w-24 shrink-0 text-[var(--color-wood-soft)]">
                {index === 0 ? (locale === 'en' ? 'Today' : '今天') : dayLabel(day.date)}
              </span>
              <span class="shrink-0 text-[var(--color-brick)]" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" set:html={ICONS[info.icon]} />
              </span>
              <span class="min-w-0 flex-1 truncate text-[var(--color-wood-soft)]" data-day-label>
                {locale === 'en' ? info.en : locale === 'zh-Hans' ? info.hans : info.zh}
              </span>
              <span class="shrink-0 text-xs text-[var(--color-slate)]" data-day-rain>
                {chance === null ? '' : `${Math.round(chance)}%`}
              </span>
              <span class="w-20 shrink-0 text-right font-semibold text-[var(--color-wood)]" data-day-temp>
                {rounded(day.max)}° / {rounded(day.min)}°
              </span>
            </li>
          );
        })}
        {!initial && (
          <li class="px-5 py-6 text-sm text-[var(--color-slate)]">
            {copy.unavailable} {copy.fallbackHint}
          </li>
        )}
      </ul>
    </div>
  </div>

  <!-- 出行建議核心區：一句話結論 + 出行穿搭 / 遊玩安排 / 隨身物品 -->
  <div class="mt-8">
    <p class="font-serif text-lg text-[var(--color-wood)]">{copy.adviceTitle}</p>
    <div class="mt-4" data-wx-advice set:html={adviceHtml} />
  </div>

  <p class="mt-6 text-xs leading-6 text-[var(--color-slate)]" data-wx="disclaimer">
    {copy.disclaimer}
  </p>
</section>

<script type="application/json" id={`${id}-config`} set:html={JSON.stringify(config)} is:inline></script>

<script>
  import {
    ENDPOINT,
    buildQuery,
    normalizeWeather,
    weatherCodeInfo,
    buildAdvice,
    adviceFactsFromSnapshot,
    weatherChips,
    type RawWeatherPayload,
  } from '../lib/weather';
  import { renderAdviceHtml, renderAlertsHtml, renderChipsHtml } from '../lib/weather-ui';

  const icon = (icons: Record<string, string>, name: string) =>
    '<svg viewBox="0 0 24 24" width="26" height="26">' + (icons[name] || icons.partly) + '</svg>';

  const setup = (scope: Element) => {
    const id = scope.id;
    if (!id) return;
    const node = document.getElementById(id + '-config');
    if (!node) return;

    let cfg: {
      latitude: number;
      longitude: number;
      timezone: string;
      locale: string;
      icuLocale: string;
      adviceLocale: 'zh-Hant' | 'zh-Hans' | 'en';
      labels: { alertTitle: string; dress: string; plan: string; pack: string };
      copy: {
        feels: string;
        humidity: string;
        wind: string;
        precip: string;
        rainChance: string;
        umbrella: string[];
        updated: string;
        loading: string;
        unavailable: string;
        windUnit: string;
        refresh: string;
      };
      icons: Record<string, string>;
    };
    try {
      cfg = JSON.parse(node.textContent || '{}');
    } catch {
      return;
    }

    const CACHE_KEY = 'kzbs-weather-' + id;
    const TTL = 20 * 60 * 1000;

    const label = (info: { zh: string; hans: string; en: string }) =>
      cfg.icuLocale === 'en' ? info.en : cfg.icuLocale === 'zh-Hans' ? info.hans : info.zh;

    const dayText = (dateStr: string, index: number) => {
      if (index === 0) return cfg.icuLocale === 'en' ? 'Today' : '今天';
      try {
        return new Intl.DateTimeFormat(cfg.locale, { weekday: 'short', month: 'numeric', day: 'numeric' }).format(
          new Date(dateStr + 'T12:00:00+08:00'),
        );
      } catch {
        return dateStr;
      }
    };

    const clockText = (iso: string) => {
      try {
        return new Intl.DateTimeFormat(cfg.locale, {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Asia/Taipei',
        }).format(new Date(iso));
      } catch {
        return '';
      }
    };

    const setText = (key: string, value: string) => {
      const el = scope.querySelector('[data-wx="' + key + '"]');
      if (el) el.textContent = value;
    };

    const setHtml = (selector: string, html: string) => {
      const el = scope.querySelector(selector);
      if (el) el.innerHTML = html;
    };

    const render = (raw: unknown) => {
      const fetchedAt =
        raw && typeof raw === 'object' && 'fetchedAt' in raw && typeof (raw as { fetchedAt?: unknown }).fetchedAt === 'string'
          ? (raw as { fetchedAt: string }).fetchedAt
          : new Date().toISOString();
      const snapshot = normalizeWeather(raw as RawWeatherPayload, fetchedAt);
      if (!snapshot) return false;

      const cur = snapshot.current;
      const nowInfo = weatherCodeInfo(cur.weatherCode);

      setText('temp', Math.round(cur.temperature) + '°');
      setText('label', label(nowInfo));
      setText('feels', Math.round(cur.apparent) + '°C');
      setText('humidity', Math.round(cur.humidity) + '%');
      setText('wind', Math.round(cur.windSpeed) + ' ' + cfg.copy.windUnit);
      setText('precip', Number(cur.precipitation).toFixed(1) + ' mm');

      const umbrellaEl = scope.querySelector('[data-wx="umbrella"]');
      if (umbrellaEl) umbrellaEl.textContent = cfg.copy.umbrella[weatherCodeInfo(snapshot.daily[0].code).umbrella] || '';

      const heroIcon = scope.querySelector('[data-wx-icon]');
      if (heroIcon) heroIcon.innerHTML = cfg.icons[nowInfo.icon] || cfg.icons.partly;

      const list = scope.querySelector('[data-wx-daily]');
      if (list) {
        list.innerHTML = snapshot.daily
          .map((day, index) => {
            const info = weatherCodeInfo(day.code);
            const chance =
              day.precipProbability === null || day.precipProbability === undefined
                ? ''
                : Math.round(day.precipProbability) + '%';
            return (
              '<li class="flex items-center gap-3 px-5 py-3 text-sm">' +
              '<span class="w-24 shrink-0 text-[var(--color-wood-soft)]">' + dayText(day.date, index) + '</span>' +
              '<span class="shrink-0 text-[var(--color-brick)]" aria-hidden="true">' + icon(cfg.icons, info.icon) + '</span>' +
              '<span class="min-w-0 flex-1 truncate text-[var(--color-wood-soft)]">' + label(info) + '</span>' +
              '<span class="shrink-0 text-xs text-[var(--color-slate)]">' + chance + '</span>' +
              '<span class="w-20 shrink-0 text-right font-semibold text-[var(--color-wood)]">' +
              Math.round(day.max) + '° / ' + Math.round(day.min) + '°</span>' +
              '</li>'
            );
          })
          .join('');
      }

      /* 建議區塊與數字同步重建，避免出現「新數字 + 舊建議」 */
      const facts = adviceFactsFromSnapshot(snapshot);
      const advice = buildAdvice(facts, cfg.adviceLocale);
      setHtml('[data-wx-chips]', renderChipsHtml(weatherChips(facts, cfg.adviceLocale)));
      setHtml('[data-wx-alerts]', renderAlertsHtml(advice, cfg.labels));
      setHtml('[data-wx-advice]', renderAdviceHtml(advice, cfg.labels));

      setText('updated-line', cfg.copy.updated + ' ' + clockText(fetchedAt));
      return true;
    };

    const readCache = () => {
      try {
        const raw = sessionStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || !parsed.fetchedAt) return null;
        if (Date.now() - new Date(parsed.fetchedAt).getTime() > TTL) return null;
        return parsed;
      } catch {
        return null;
      }
    };

    const writeCache = (data: unknown) => {
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify(data));
      } catch {
        /* 忽略儲存失敗 */
      }
    };

    const load = async () => {
      try {
        const query = buildQuery(cfg.latitude, cfg.longitude, cfg.timezone);
        const response = await fetch(ENDPOINT + '?' + query.toString(), { cache: 'no-store' });
        if (!response.ok) throw new Error('bad status');
        const data = await response.json();
        if (data && data.current && data.daily) {
          data.fetchedAt = new Date().toISOString();
          writeCache(data);
          render(data);
        }
      } catch {
        /* 連線失敗時保留伺服器端內容 */
      }
    };

    const cached = readCache();
    if (cached) render(cached);
    else load();

    const refresh = scope.querySelector('[data-wx-refresh]');
    if (refresh) {
      refresh.addEventListener('click', () => {
        try {
          sessionStorage.removeItem(CACHE_KEY);
        } catch {
          /* 忽略 */
        }
        const line = scope.querySelector('[data-wx="updated-line"]');
        if (line) line.textContent = cfg.copy.loading;
        load();
      });
    }
  };

  document.querySelectorAll('[data-wx-scope]').forEach(setup);
</script>
