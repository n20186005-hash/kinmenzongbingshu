---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { getLocalImage } from '../../lib/images';
import { localizedPath } from '../../i18n/config';
import { getLocalizedContent, type TranslatedLocale } from '../../i18n/content';
import type { LocalizedFullPage } from '../../i18n/full-pages';
import {
  localizedNearby, hansFood, hansFoodByTime, hansFoodCombos, hansFoodTopThree,
  englishFood, englishFoodByTime, englishFoodCombos, englishFoodTopThree,
} from '../../i18n/detail';

const { locale, page } = Astro.props as { locale: TranslatedLocale; page: LocalizedFullPage };
const en = locale === 'en';
const lp = (path: string) => localizedPath(locale, path);
const spots = localizedNearby(locale) as any[];
const food = (en ? englishFood : hansFood) as any[];
const foodByTime = (en ? englishFoodByTime : hansFoodByTime) as readonly (readonly [string, string])[];
const foodCombos = (en ? englishFoodCombos : hansFoodCombos) as any[];
const foodTopThree = (en ? englishFoodTopThree : hansFoodTopThree) as any[];
const content = getLocalizedContent(locale);
const slug = page.path.split('/').filter(Boolean).at(-1);
const spot = spots.find((item) => item.slug === slug);
const kind = page.path === '/nearby/' ? 'index' : page.path === '/nearby/food/' ? 'food' : page.path === '/nearby/houpu-old-street/' ? 'walk' : page.path === '/nearby/model-street/' ? 'model' : 'spot';
const image = page.image ? getLocalImage(page.image) : spot ? getLocalImage(spot.image) : undefined;
const labels = en ? {
  home: 'Home', nearby: 'Nearby', nearbyEyebrow: 'Nearby Houpu', timePlan: 'Choose by the time you have', food: 'Food nearby', foodLead: 'Seven breakfast, snack and dessert stops within a short walk.', viewFood: 'See the food guide', walk: 'Two-hour Houpu heritage walk', walkLead: 'Monuments, an academy, temples and the old street in one route.', start: 'Start the route', model: 'Mofan Street', modelLead: 'Houpu’s most photogenic red-brick arcade street.', learn: 'Explore Mofan Street', atlas: 'Walking guide', allWalkable: 'All are walkable from the headquarters', credits: 'Photo source and licence', what: 'History and significance', highlights: 'What to see', tips: 'Visiting tips', from: 'From the headquarters', map: 'Open map directions', identity: 'Heritage status', stay: 'Suggested time', access: 'Access', accessText: 'Outdoor features can be viewed directly. Follow current notices for interiors and events.', official: 'Official Kinmen tourism information', all: 'All nearby sights', route: 'Houpu heritage route', routeMeta: 'About two hours on foot', seven: 'Seven local food stops', introFood: 'Houpu old town · food walk', foodTitle: 'Where to eat near the headquarters', galleryNote: 'Representative Kinmen foods; photographs do not identify a particular shop.', sevenTitle: 'Seven worthwhile stops', sevenSub: 'From breakfast to dessert without leaving the old town', recommend: 'Order', hours: 'Hours', address: 'Address', goodFor: 'Good for', reminder: 'Tip', illustration: 'Representative image', cash: 'Bring New Taiwan dollar cash; the official listing indicates cash payment.', byTime: 'Choose by arrival time', byTimeTitle: 'What to eat at each time of day', arrival: 'Arrival time', choice: 'Suggested plan', combos: 'Three practical combinations', combosTitle: 'Join food and sights into one walk', practical: 'Practical reminder', practicalText: 'Traditional shops often keep short hours and may close after selling out. Check current opening before setting out and carry cash for small vendors.', top: 'If you choose only three', topText: 'Together these cover a traditional breakfast, Kinmen oysters and an old-town dessert.', afterFood: 'Continue to the night tour', count: 'stops', duration: 'About 2 hours', free: 'Free sights', suggested: 'Suggested', next: 'Next stop', detail: 'View full guide', photo: 'Photography tips', directions: 'Walking from the headquarters', open: 'Open', admission: 'Admission', distance: 'Distance', outdoor: 'Outdoor street · always accessible', noFee: 'Free',
} : {
  home: '首页', nearby: '附近景点', nearbyEyebrow: '周边顺游', timePlan: '按剩余时间安排顺游', food: '附近美食', foodLead: '广东粥、油条、蚵嗲、豆花等 7 家步行可达老店。', viewFood: '查看美食推荐', walk: '后浦老街深度路线', walkLead: '约 2 小时，古迹、书院、庙宇和老街一次走完。', start: '开始路线', model: '模范街', modelLead: '后浦最上镜的红砖连廊式老街。', learn: '了解模范街', atlas: '实景图鉴', allWalkable: '全部从总兵署步行可达', credits: '实景照片 · 查看来源与授权', what: '历史与意义', highlights: '现场重点看什么', tips: '到访提示', from: '从总兵署出发', map: '打开地图导航', identity: '文化身份', stay: '建议停留', access: '参观提醒', accessText: '户外可直接观赏；室内开放与活动安排以现场公告为准。', official: '金门观光旅游网资料', all: '全部附近景点', route: '后浦老街深度路线', routeMeta: '约 2 小时走完精华', seven: '步行可达的 7 家老店', introFood: '周边顺游 · 后浦老城区', foodTitle: '总兵署附近吃什么', galleryNote: '上图为金门代表小吃示意，不代表特定店家。', sevenTitle: '最值得推荐的 7 家', sevenSub: '从早餐到甜品，一条街吃完', recommend: '推荐', hours: '营业', address: '地址', goodFor: '适合', reminder: '提醒', illustration: '示意图', cash: '官方页面标注以现金支付为主，建议准备新台币现金。', byTime: '按时间直接选择', byTimeTitle: '几点到，就吃什么', arrival: '到访时间', choice: '推荐吃法', combos: '最推荐的三套组合', combosTitle: '把景点和吃串成一条线', practical: '实用提醒', practicalText: '传统店铺普遍营业时间较短，部分品项卖完会提前结束。出发前确认当天营业，并准备新台币现金。', top: '只选三家的话', topText: '这三家覆盖金门传统早餐、石蚵小吃与后浦老街甜品。', afterFood: '吃完接上夜游', count: '站', duration: '约 2 小时', free: '全程免费', suggested: '建议', next: '下一站', detail: '查看景点详情', photo: '拍照建议', directions: '从总兵署怎么走', open: '开放', admission: '门票', distance: '距总兵署', outdoor: '户外老街 · 全天', noFee: '免费',
};
const walks = en ? [
  ['30-minute extension', 'Headquarters → memorial arch → General’s Residence'],
  ['One-hour extension', 'Headquarters → Wujiang Academy → Mofan Street → City God Temple'],
  ['Two-hour route', 'A complete old-town walk through monuments, education, belief and commerce'],
] : [
  ['30 分钟顺游', '总兵署 → 邱良功母节孝坊 → 将军第'],
  ['1 小时顺游', '总兵署 → 浯江书院 → 模范街 → 城隍庙'],
  ['2 小时深度', '后浦老街深度路线，串联古迹、书院、庙宇与老街'],
];
const gallery = en ? [['food-congee.jpg','Congee'],['food-youtiao.jpg','Fried dough'],['food-oyster.jpg','Oyster fritter'],['food-douhua.jpg','Tofu pudding'],['food-saltycake.jpg','Savoury cake'],['food-porkrice.jpg','Braised-pork rice']] : [['food-congee.jpg','广东粥'],['food-youtiao.jpg','油条'],['food-oyster.jpg','蚵嗲'],['food-douhua.jpg','豆花'],['food-saltycake.jpg','咸粿'],['food-porkrice.jpg','肉燥饭']];
const oldStops = [
  { name: content.attractionName, img: 'exterior2.jpg', min: 45, note: en ? 'Begin with all four courtyards of the Qing military-administrative compound.' : '先在署内走完四进院落，再出发探索后浦老街。' },
  ...['memorial-arch','general-residence','wujiang-academy','kuige','city-god-temple','model-street'].map((id) => { const item = spots.find((s) => s.slug === id); return { name: item.name, img: item.image, min: id === 'model-street' ? 30 : id === 'wujiang-academy' || id === 'city-god-temple' ? 15 : 10, note: item.note, href: item.href }; }),
];
const oldStopItems = oldStops.map((item, index) => ({
  ...item,
  order: index + 1,
  nextName: oldStops[index + 1]?.name,
}));
const modelPoints = en ? [
  ['Red-brick arcades', 'Shophouses step back to form a continuous covered walkway whose repeated arches define the street.'],
  ['Consistent façades', 'Similar heights, windows and parapets create an unusually ordered and photogenic townscape.'],
  ['Light and shadow', 'Morning and late-afternoon light passes through the arches and creates rhythmic shadows.'],
] : [['红砖连廊','两侧洋楼一楼向内退缩形成连续骑楼廊道，红砖拱圈整齐排列。'],['对称立面','整条街的洋楼高度、开窗与山墙几乎一致。'],['光影时段','清晨与傍晚斜光穿过连廊，是拍照最佳时刻。']];
const modelTips = en ? ['Use the street axis to turn the arches into a strong vanishing point.','Return after the lights come on for warm light against red brick.','Use an arcade opening as a foreground frame.'] : ['站在街道中央拍摄，让连廊拱圈形成透视消失点。','傍晚亮灯后拍，暖色灯光配红砖最有味道。','走进骑楼廊下，用拱圈当前景框住街景。'];
---

{kind === 'index' && <Layout title={page.title} description={page.description} active="/nearby/" pageType="Article">
  <PageHeader eyebrow={page.eyebrow} crumb={labels.nearby} title={page.title} intro={page.intro} />
  <div class="container-page py-12"><h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{labels.timePlan}</h2><div class="mt-5 grid gap-4 md:grid-cols-3">{walks.map(([time, route]) => <a href={lp('/nearby/houpu-old-street/')} class="card transition-transform hover:-translate-y-1"><div class="font-serif text-lg font-bold text-[var(--color-brick)]">{time}</div><p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{route}</p></a>)}</div>
    <a href={lp('/nearby/food/')} class="mt-10 block overflow-hidden rounded-2xl shadow-[var(--shadow-card)] transition-transform hover:-translate-y-1"><div class="relative"><ResponsiveImage src="food-street.jpg" alt={labels.food} class="h-48 w-full object-cover sm:h-56" sizes="100vw" maxWidth={960}/><div class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink)]/85 to-[var(--color-ink)]/25"></div><div class="absolute inset-0 flex flex-col justify-center p-6 sm:p-8"><div class="eyebrow !text-white/80">{labels.food}</div><div class="mt-2 font-serif text-3xl font-black text-white">{labels.foodTitle}</div><p class="mt-2 max-w-md text-sm text-white/85">{labels.foodLead}</p><span class="mt-3 text-sm font-medium text-white">{labels.viewFood} →</span></div></div></a>
    <div class="mt-6 grid gap-4 md:grid-cols-2">{[[lp('/nearby/houpu-old-street/'), 'historic.jpg', labels.walk, labels.walkLead, labels.start],[lp('/nearby/model-street/'),'model-street.jpg',labels.model,labels.modelLead,labels.learn]].map(([href,img,title,text,action]) => <a href={href} class="group relative block overflow-hidden rounded-2xl shadow-[var(--shadow-card)]"><ResponsiveImage src={img} alt={title} class="h-44 w-full object-cover transition-transform duration-500 group-hover:scale-105" sizes="(min-width:768px) 50vw,100vw" maxWidth={960}/><div class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink)]/85 to-transparent"></div><div class="absolute inset-0 flex flex-col justify-center p-6"><div class="font-serif text-2xl font-black text-white">{title}</div><p class="mt-1 max-w-xs text-sm text-white/85">{text}</p><span class="mt-2 text-sm font-medium text-white">{action} →</span></div></a>)}</div>
    <div class="mt-12 flex items-end justify-between"><div><p class="eyebrow">{labels.atlas}</p><h2 class="mt-2 font-serif text-2xl font-bold text-[var(--color-ink)]">{labels.nearby}</h2></div><p class="text-sm text-[var(--color-slate)]">{labels.allWalkable}</p></div>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{spots.map((item) => <a href={lp(item.href)} class="group overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)] transition-transform hover:-translate-y-1"><div class="relative overflow-hidden"><ResponsiveImage src={item.image} alt={item.imageAlt} class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105" sizes="(min-width:1024px) 33vw,(min-width:640px) 50vw,100vw" maxWidth={720}/><span class="absolute left-3 top-3 rounded-full bg-[var(--color-ink)]/75 px-3 py-1 text-xs text-white">{item.heritage}</span></div><div class="p-5"><div class="flex justify-between gap-3"><h3 class="font-serif text-xl font-bold text-[var(--color-ink)]">{item.name}</h3><span class="text-[var(--color-brick)]">→</span></div><p class="mt-2 text-sm leading-6 text-[var(--color-wood-soft)]">{item.note}</p><div class="mt-4 flex justify-between border-t border-[var(--color-slate-line)] pt-3 text-xs text-[var(--color-slate)]"><span>{item.walk}</span><span>{item.stay}</span></div></div></a>)}</div>
  </div>
</Layout>}

{kind === 'spot' && spot && <Layout title={spot.name} description={page.description} active="/nearby/" pageType="Article" preloadImage={image} preloadSizes="100vw">
  <section class="relative min-h-[26rem] overflow-hidden"><div class="absolute inset-0"><ResponsiveImage src={image!} alt={spot.imageAlt} class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high"/><div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/90 via-[var(--color-ink)]/50 to-[var(--color-ink)]/25"></div></div><div class="container-page relative flex min-h-[26rem] flex-col justify-end py-12 sm:py-16"><nav class="mb-3 text-xs text-white/75"><a href={lp('/')}>{labels.home}</a> / <a href={lp('/nearby/')}>{labels.nearby}</a> / {spot.name}</nav><p class="eyebrow !text-white/80">{labels.nearbyEyebrow} · {spot.walk}</p><h1 class="mt-3 font-serif text-3xl font-black !text-white sm:text-5xl">{spot.name}</h1><p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">{spot.lead}</p><div class="mt-5 flex flex-wrap gap-2 text-sm text-white">{[spot.heritage,spot.walk,spot.stay].map((x)=><span class="rounded-full bg-white/15 px-4 py-2 backdrop-blur">{x}</span>)}</div><a href={lp('/credits/')} class="mt-4 w-fit text-xs text-white/65">{labels.credits} →</a></div></section>
  <div class="container-page py-12"><div class="grid gap-10 lg:grid-cols-3"><main class="lg:col-span-2"><section class="prose-cn"><h2>{spot.name}: {labels.what}</h2><p>{spot.history}</p></section><section class="mt-10"><h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{labels.highlights}</h2><div class="mt-5 grid gap-4 sm:grid-cols-3">{spot.highlights.map((item,index)=><article class="rounded-2xl bg-white p-5 shadow-[var(--shadow-card)]"><span class="text-xs font-bold text-[var(--color-brick)]">0{index+1}</span><h3 class="mt-2 font-serif text-lg font-bold text-[var(--color-ink)]">{item.title}</h3><p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{item.text}</p></article>)}</div></section><section class="mt-10 rounded-2xl bg-[var(--color-paper-deep)] p-6 sm:p-8"><h2 class="font-serif text-xl font-bold text-[var(--color-ink)]">{labels.tips}</h2><ul class="mt-4 space-y-3 text-sm leading-7 text-[var(--color-wood-soft)]">{spot.tips.map((tip)=><li class="flex gap-3"><span class="text-[var(--color-brick)]">●</span><span>{tip}</span></li>)}</ul></section></main>
    <aside class="space-y-5"><div class="card"><div class="text-sm font-semibold text-[var(--color-ink)]">{labels.from}</div><div class="mt-3 font-serif text-2xl font-black text-[var(--color-brick)]">{spot.walk}</div><p class="mt-2 text-sm leading-6 text-[var(--color-wood-soft)]">{spot.distance}</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(spot.mapQuery)}`} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full">{labels.map} ↗</a></div><div class="card"><dl class="space-y-4 text-sm"><div><dt class="text-xs text-[var(--color-slate)]">{labels.identity}</dt><dd class="mt-1 font-bold text-[var(--color-ink)]">{spot.heritage}</dd></div><div><dt class="text-xs text-[var(--color-slate)]">{labels.stay}</dt><dd class="mt-1 font-bold text-[var(--color-ink)]">{spot.stay}</dd></div><div><dt class="text-xs text-[var(--color-slate)]">{labels.access}</dt><dd class="mt-1 leading-6">{labels.accessText}</dd></div></dl></div><a href={spot.officialUrl} target="_blank" rel="noopener" class="card flex justify-between text-sm font-medium text-[var(--color-brick)]">{labels.official}<span>↗</span></a></aside></div>
    <div class="mt-12 grid gap-4 sm:grid-cols-3">{[[labels.all,'/nearby/',labels.allWalkable],[labels.route,'/nearby/houpu-old-street/',labels.routeMeta],[labels.food,'/nearby/food/',labels.seven]].map(([title,href,meta])=><a href={lp(href)} class="card flex items-center justify-between"><div><div class="font-bold text-[var(--color-ink)]">{title}</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">{meta}</div></div><span class="text-[var(--color-brick)]">→</span></a>)}</div>
  </div>
</Layout>}

{kind === 'food' && <Layout title={page.title} description={page.description} active="/nearby/" pageType="Article" preloadImage={image} preloadSizes="100vw">
  <section class="relative overflow-hidden"><div class="absolute inset-0"><ResponsiveImage src={image!} alt={labels.foodTitle} class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high"/><div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/85 via-[var(--color-ink)]/50 to-[var(--color-ink)]/35"></div></div><div class="container-page relative py-16 sm:py-20"><nav class="mb-3 text-xs text-white/70"><a href={lp('/')}>{labels.home}</a> / <a href={lp('/nearby/')}>{labels.nearby}</a> / {labels.food}</nav><p class="eyebrow !text-white/80">{labels.introFood}</p><h1 class="mt-3 font-serif text-3xl font-black text-white sm:text-5xl">{labels.foodTitle}</h1><p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">{page.intro}</p></div></section>
  <section class="container-page mt-10"><div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">{gallery.map(([img,name])=><div class="group relative overflow-hidden rounded-2xl shadow-[var(--shadow-card)]"><ResponsiveImage src={img} alt={name} class="aspect-[4/3] w-full object-cover transition-transform group-hover:scale-105" sizes="(min-width:768px) 16vw,50vw" maxWidth={720}/><div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div><span class="absolute bottom-2 left-3 font-serif text-lg font-bold text-white">{name}</span></div>)}</div><p class="mt-2 text-xs text-[var(--color-slate)]">{labels.galleryNote} <a class="underline" href={lp('/credits/')}>{labels.credits}</a>.</p></section>
  <section class="container-page mt-14"><p class="eyebrow">{labels.sevenTitle}</p><h2 class="mt-2 text-3xl">{labels.sevenSub}</h2><div class="mt-8 grid gap-6 lg:grid-cols-2">{food.map((item)=><article class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]"><div class="relative aspect-[16/9] overflow-hidden"><ResponsiveImage src={item.img} alt={`${item.name}: ${item.recommend}`} class="h-full w-full object-cover" sizes="(min-width:1024px) 50vw,100vw" maxWidth={720}/><div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div><span class="absolute left-4 top-4 grid h-9 w-9 place-items-center rounded-full step-num text-sm">{item.num}</span>{item.illust&&<span class="absolute bottom-3 right-3 rounded-full bg-black/45 px-2 py-0.5 text-[11px] text-white">{labels.illustration}</span>}</div><div class="flex flex-1 flex-col p-5"><div class="flex justify-between gap-3"><div><h3 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{item.name}</h3><p class="mt-0.5 text-sm text-[var(--color-brick)]">{item.tagline}</p></div><span class="h-fit shrink-0 rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs">{item.distance}</span></div><div class="mt-3 rounded-xl bg-[var(--color-paper-deep)] px-4 py-2.5 text-sm"><span class="text-[var(--color-slate)]">{labels.recommend} · </span><strong>{item.recommend}</strong></div><p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-wood-soft)]">{item.desc}</p><dl class="mt-4 space-y-1.5 text-sm">{[[labels.hours,item.hours],[labels.address,item.address],[labels.goodFor,item.goodFor]].map(([a,b])=><div class="flex gap-2"><dt class="w-16 shrink-0 text-[var(--color-slate)]">{a}</dt><dd>{b}</dd></div>)}</dl><div class="mt-4 rounded-xl border border-[var(--color-slate-line)] bg-[var(--color-paper)] px-3 py-2.5 text-xs leading-6"><span class="mr-2 text-[var(--color-kapok)]">{labels.reminder}</span>{item.tip}</div>{item.cash&&<div class="mt-2 text-[11px] text-[var(--color-slate)]">💵 {labels.cash}</div>}</div></article>)}</div></section>
  <section class="container-page mt-16"><p class="eyebrow">{labels.byTime}</p><h2 class="mt-2 text-3xl">{labels.byTimeTitle}</h2><div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]"><table class="w-full text-sm"><thead><tr class="bg-[var(--color-paper-deep)] text-left"><th class="p-4">{labels.arrival}</th><th class="p-4">{labels.choice}</th></tr></thead><tbody>{foodByTime.map(([time,rec])=><tr class="border-t border-[var(--color-slate-line)]"><td class="whitespace-nowrap p-4 font-serif font-bold text-[var(--color-brick)]">{time}</td><td class="p-4">{rec}</td></tr>)}</tbody></table></div></section>
  <section class="container-page mt-16"><p class="eyebrow">{labels.combos}</p><h2 class="mt-2 text-3xl">{labels.combosTitle}</h2><div class="mt-6 grid gap-5 md:grid-cols-3">{foodCombos.map((item)=><div class="card flex flex-col"><h3 class="font-serif text-lg font-bold">{item.title}</h3><div class="mt-3 flex-1 rounded-xl bg-[var(--color-paper-deep)] p-4 text-sm leading-7">{item.route}</div><p class="mt-3 text-sm">{item.note}</p></div>)}</div></section>
  <section class="container-page mt-16"><div class="grid gap-6 lg:grid-cols-3"><div class="card lg:col-span-2"><h2 class="font-serif text-xl font-bold">{labels.practical}</h2><p class="mt-3 leading-8">{labels.practicalText}</p></div><div class="rounded-2xl bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6 text-white"><div class="text-sm font-semibold text-white/80">{labels.top}</div><ul class="mt-4 space-y-3">{foodTopThree.map((item)=><li class="flex items-center gap-3"><span class="rounded-full bg-white/20 px-2.5 py-1 text-xs">{item.label}</span><span class="font-serif text-lg font-bold">{item.name}</span></li>)}</ul><p class="mt-4 text-xs leading-6 text-white/75">{labels.topText}</p></div></div></section>
  <section class="container-page mt-14"><div class="grid gap-4 sm:grid-cols-2"><a href={lp('/nearby/')} class="card flex justify-between"><div><strong>{labels.nearby}</strong><div class="mt-1 text-sm">{labels.allWalkable}</div></div><span>→</span></a><a href={lp('/houpu-night-walk/')} class="card flex justify-between"><div><strong>{labels.afterFood}</strong><div class="mt-1 text-sm">19:30</div></div><span>→</span></a></div></section>
</Layout>}

{kind === 'walk' && <Layout title={page.title} description={page.description} active="/nearby/" pageType="Article" preloadImage={image} preloadSizes="100vw">
  <section class="relative overflow-hidden"><div class="absolute inset-0"><ResponsiveImage src={image!} alt={page.title} class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high"/><div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/85 via-[var(--color-ink)]/50 to-[var(--color-ink)]/35"></div></div><div class="container-page relative py-16 sm:py-20"><nav class="text-xs text-white/70"><a href={lp('/')}>{labels.home}</a> / <a href={lp('/nearby/')}>{labels.nearby}</a> / {page.title}</nav><p class="eyebrow mt-3 !text-white/80">{labels.nearbyEyebrow}</p><h1 class="mt-3 font-serif text-3xl font-black text-white sm:text-5xl">{page.title}</h1><p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">{page.intro}</p><div class="mt-5 flex gap-2 text-sm text-white">{[`${oldStops.length} ${labels.count}`,labels.duration,labels.free].map((x)=><span class="rounded-full bg-white/15 px-4 py-2">{x}</span>)}</div></div></section>
  <div class="container-page py-12"><ol class="relative space-y-6 border-l-2 border-[var(--color-slate-line)] pl-6 sm:pl-8">{oldStopItems.map((item)=><li class="relative"><span class="absolute -left-[34px] grid h-8 w-8 place-items-center rounded-full step-num text-sm font-bold sm:-left-[42px]">{item.order}</span><div class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]"><div class="flex flex-col sm:flex-row"><div class="shrink-0 sm:w-56"><ResponsiveImage src={item.img} alt={item.name} class="h-44 w-full object-cover sm:h-full" sizes="(min-width:640px) 224px,100vw" maxWidth={640}/></div><div class="flex-1 p-5"><div class="flex items-center gap-3"><h3 class="font-serif text-xl font-bold">{item.name}</h3><span class="text-xs text-[var(--color-slate)]">{labels.suggested} {item.min} min</span></div><p class="mt-2 text-sm leading-7">{item.note}</p>{item.href&&<a href={lp(item.href)} class="mt-3 inline-block text-sm font-medium text-[var(--color-brick)]">{labels.detail} →</a>}{item.nextName&&<div class="mt-3 text-xs font-medium text-[var(--color-brick)]">{labels.next} → {item.nextName}</div>}</div></div></div></li>)}</ol></div>
</Layout>}

{kind === 'model' && <Layout title={page.title} description={page.description} active="/nearby/" pageType="Article" preloadImage={image} preloadSizes="100vw">
  <section class="relative overflow-hidden"><div class="absolute inset-0"><ResponsiveImage src={image!} alt={page.title} class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high"/><div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/85 via-[var(--color-ink)]/45 to-[var(--color-ink)]/30"></div></div><div class="container-page relative py-16 sm:py-20"><nav class="text-xs text-white/70"><a href={lp('/')}>{labels.home}</a> / <a href={lp('/nearby/')}>{labels.nearby}</a> / {page.title}</nav><p class="eyebrow mt-3 !text-white/80">{labels.nearbyEyebrow}</p><h1 class="mt-3 font-serif text-5xl font-black !text-white">{page.title}</h1><p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">{page.intro}</p></div></section>
  <div class="container-page py-12"><div class="grid gap-10 lg:grid-cols-3"><div class="prose-cn lg:col-span-2"><h2>{page.sections[0].title}</h2><p>{page.sections[0].text}</p><h2>{labels.highlights}</h2><div class="not-prose mt-4 grid gap-4 sm:grid-cols-3">{modelPoints.map(([title,text])=><div class="rounded-2xl bg-white p-5 shadow-[var(--shadow-card)]"><h3 class="font-serif text-lg font-bold">{title}</h3><p class="mt-2 text-sm leading-6">{text}</p></div>)}</div><h2>{labels.photo}</h2><ul>{modelTips.map((tip)=><li>· {tip}</li>)}</ul></div><aside class="space-y-5"><div class="card"><h3 class="font-semibold">{labels.directions}</h3><ol class="mt-3 space-y-2 text-sm">{(en?['Walk towards Wujiang Street and Juguang Road.','Pass the memorial arch and continue for a few minutes.','The route is level and normally takes 3–5 minutes.']:['沿浯江街／莒光路方向步行。','经过邱良功母节孝坊后继续前行。','全程平地，步行约 3–5 分钟。']).map((x,i)=><li>{i+1}. {x}</li>)}</ol></div><div class="card"><div class="grid grid-cols-2 gap-3 text-sm">{[[labels.open,labels.outdoor],[labels.admission,labels.noFee],[labels.distance,en?'3–5 minute walk':'步行 3–5 分钟'],[labels.stay,en?'20–40 minutes':'20–40 分钟']].map(([a,b])=><div><div class="text-xs text-[var(--color-slate)]">{a}</div><div class="mt-1 font-bold">{b}</div></div>)}</div></div><div class="overflow-hidden rounded-2xl"><ResponsiveImage src="food-street.jpg" alt={page.title} class="aspect-[3/4] w-full object-cover" sizes="(min-width:1024px) 33vw,100vw" maxWidth={720}/></div></aside></div></div>
</Layout>}
