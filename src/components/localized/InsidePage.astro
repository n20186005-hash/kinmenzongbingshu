---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { localizedPath } from '../../i18n/config';
import { getLocalizedContent, type TranslatedLocale } from '../../i18n/content';
const { locale } = Astro.props as { locale: TranslatedLocale };
const content = getLocalizedContent(locale);
const copy = locale === 'en' ? { title: 'What is inside the headquarters?', eyebrow: 'Interior spaces', crumb: 'Inside', intro: 'Follow the visitor route from the Main Gate to the rear courtyard, with the original function and key details of every space.', description: 'A complete room-by-room guide to the Kinmen Military Headquarters.', approx: 'About', highlights: 'Look for', map: 'Open the interactive map', route: 'Choose a timed route' } : { title: '总兵署里面有什么', eyebrow: '内部空间', crumb: '里面有什么', intro: '沿参观动线，从头门到后院，逐间告诉你这里原来做什么、重点看什么。', description: '清金门镇总兵署内部空间逐间介绍。', approx: '约', highlights: '看点', map: '打开互动平面图', route: '按时间选择路线' };
---
<Layout title={copy.title} description={copy.description} active="/map/" pageType="Article">
  <PageHeader eyebrow={copy.eyebrow} crumb={copy.crumb} title={copy.title} intro={copy.intro} />
  <div class="container-page py-12"><div class="space-y-6">
    {content.rooms.map((room) => <article id={room.id} class="scroll-mt-24 overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]"><div class="flex flex-col md:flex-row">
      <div class="shrink-0 md:w-72"><ResponsiveImage src={room.image} alt={room.name} class="h-52 w-full object-cover md:h-full" sizes="(min-width: 768px) 288px, 100vw" maxWidth={720} /></div>
      <div class="flex-1 p-6"><div class="flex flex-wrap items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-full step-num text-sm font-bold">{room.num}</span><h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{room.name}</h2><span class="text-xs text-[var(--color-slate)]">{copy.approx} {room.minutes} min</span></div><p class="mt-3 leading-7 text-[var(--color-wood-soft)]">{room.summary}</p><div class="mt-4 flex flex-wrap gap-1.5">{room.see.map((item) => <span class="rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs text-[var(--color-wood-soft)]">{copy.highlights} · {item}</span>)}</div></div>
    </div></article>)}
  </div><div class="mt-8 flex flex-wrap gap-3"><a href={localizedPath(locale, '/map/')} class="btn btn-primary">{copy.map} →</a><a href={localizedPath(locale, '/visit/#routes')} class="btn btn-secondary">{copy.route} →</a></div></div>
</Layout>
