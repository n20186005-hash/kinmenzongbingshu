---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { localizedPath } from '../../i18n/config';
import { photoCredits, site } from '../../data/site';
import type { LocalizedFullPage } from '../../i18n/full-pages';
import type { TranslatedLocale } from '../../i18n/content';
const { locale, page } = Astro.props as { locale: TranslatedLocale; page: LocalizedFullPage };
const en = locale === 'en';
const lp = (path: string) => localizedPath(locale, path);
const kind = page.path.slice(1, -1);
const sources = en ? [
  ['Official attraction page','https://kinmen.travel/zh-tw/Travel/Attraction/393','Opening hours, admission and address.'],['Official Houpu night-tour page','https://kinmen.travel/zh-tw/discover/tour/22','Meeting time and walking route.'],['Nearby bus-stop information','https://kinmen.travel/zh-tw/nearby/ebus?placeId=393&type=Attractions','Distance from Jincheng Bus Station.'],['Shuitou rental operator listing','https://kinmen.travel/zh-tw/shop/details/2889','Vehicles, branches, one-way return, shared stations and battery swaps.'],['Shared electric transport announcement','https://kinmen.travel/zh-tw/news/details/3535','The initial six return stations and 42 shared scooters announced in 2025.'],['Kinmen rules for micro electric two-wheelers','https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=DA9DD89A686C770D&sms=BF7D6D478B935644','Registration, insurance, age, helmet, speed and passenger rules.'],['Taiwan Tourist Shuttle','https://kinmen.travel/zh-cn/information/TaiwanTrip','Sightseeing routes, fares and timetables.'],['Wikimedia Commons category','https://commons.wikimedia.org/wiki/Category:Kinmen_Military_Headquarters_of_Qing_Dynasty','Reusable attraction photographs and licence records.'],
] : [['金门观光旅游网 · 清金门镇总兵署','https://kinmen.travel/zh-tw/Travel/Attraction/393','开放时间、门票、地址等基础信息。'],['金门观光旅游网 · 后浦美丽小镇之旅','https://kinmen.travel/zh-tw/discover/tour/22','后浦夜游集合时间与路线。'],['金门观光旅游网 · 邻近公车站','https://kinmen.travel/zh-tw/nearby/ebus?placeId=393&type=Attractions','金城站与附近景点距离。'],['金门观光旅游网 · 水头租车业者','https://kinmen.travel/zh-tw/shop/details/2889','车型、门市、甲租乙还、共享站点及换电服务。'],['金门观光旅游网 · 电动共享运具','https://kinmen.travel/zh-tw/news/details/3535','2025 年首批 6 处共享租还点与 42 辆共享机车。'],['金门县政府 · 微型电动二轮车规定','https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=DA9DD89A686C770D&sms=BF7D6D478B935644','挂牌、保险、年龄、安全帽、限速与载人规定。'],['金门观光旅游网 · 台湾好行','https://kinmen.travel/zh-cn/information/TaiwanTrip','路线、票价与班次信息。'],['维基共享资源 · 清金门镇总兵署','https://commons.wikimedia.org/wiki/Category:Kinmen_Military_Headquarters_of_Qing_Dynasty','景点照片来源与 CC 授权。']];
const levels = en ? [['Officially verified','Confirmed by an official publication','official'],['Verified on site','Observed by the editorial team','onsite'],['Awaiting on-site confirmation','Third-party detail not yet checked in person','check'],['Check again before departure','Information likely to change','check']] : [['官方已核实','官方资料确认','official'],['现场已核实','编辑实地看到','onsite'],['等待现场确认','第三方信息，尚待实地核实','check'],['出发前再次确认','容易变化的信息','check']];
const copy = en ? {
  aboutTitle: 'About the Kinmen Military Headquarters Visitor Guide', before: 'Before your visit', beforeText: 'Is it worth visiting, when is it open, is admission free, how do you get there and how much time should you allow?', during: 'During your visit', duringText: 'Where should you begin, what was each room for and which details matter?', after: 'After your visit', afterText: 'Where should you go next and how can Mofan Street or the Houpu night tour fit into the day?', notOfficial: 'This is not an official website', trust: 'How the guide remains reliable', editor: 'Edited by the Kinmen Military Headquarters guide team', report: 'How to report an issue', reportText: 'Email', reportHelp: 'Include the page URL, the corrected information, your source and the date you visited or checked it.', record: 'Correction record', recordText: 'The complete Traditional Chinese, Simplified Chinese and English site launched with visitor information, routes, maps, transport, nearby sights and supporting editorial pages. Future factual changes will be recorded here.', photo: 'Photo sources and licences', photoIntro: 'Current attraction photographs come from Wikimedia Commons under the licence shown for each file. Original photography will replace them over time.', photoCol: ['Photo','Description','Photographer','Licence'], photoNote: 'CC BY and CC BY-SA require attribution; CC BY-SA also requires compatible sharing. Follow each description link for the original file and complete terms.', sourceTitle: 'Sources and verification methods', mainSources: 'Primary sources', levels: 'Confidence labels', sourceNote: 'Time-sensitive information is reviewed regularly and checked again before major holidays and events. The latest official notice always takes priority.',
} : {
  aboutTitle: '关于金门总兵署游客指南', before: '到访前', beforeText: '值得去吗、几点开、免费吗、怎么去、需要多久？', during: '参观中', duringText: '从哪里开始、每间房是什么、重点在哪里？', after: '参观后', afterText: '下一站去哪里、如何衔接模范街和后浦夜游？', notOfficial: '我们不是官方网站', trust: '我们如何保证可信', editor: '编辑：金门总兵署指南编辑组', report: '回报方式', reportText: '电子邮件', reportHelp: '请附上页面网址、正确信息、资料来源，以及到访或查看日期。', record: '修正记录', recordText: '繁中、简体与英文完整站点已上线，包含参观信息、路线、地图、交通、附近景点及编辑说明。后续事实修正将在此记录。', photo: '照片来源与授权', photoIntro: '现阶段景点照片来自维基共享资源，依各文件标注的 CC 授权署名使用，并将逐步替换为原创实拍。', photoCol: ['照片','说明','作者','授权'], photoNote: 'CC BY 与 CC BY-SA 使用时须署名原作者；CC BY-SA 还要求以相同方式共享。点击照片说明可查看原始文件与完整授权。', sourceTitle: '资料来源与核实方式', mainSources: '主要资料来源', levels: '信息可信度分级', sourceNote: '开放时间等容易变化的信息会定期核实，并在节假日及大型活动前额外检查。实际以官方最新公告为准。',
};
---
<Layout title={page.title} description={page.description} pageType="Article"><PageHeader eyebrow={page.eyebrow} crumb={page.title} title={kind==='about'?copy.aboutTitle:kind==='credits'?copy.photo:kind==='sources'?copy.sourceTitle:page.title} intro={kind==='credits'?copy.photoIntro:page.intro}/>
  {kind === 'about' && <main class="container-page py-12"><article class="prose-cn mx-auto max-w-3xl"><p><strong>{en?'Kinmen Military Headquarters Visitor Guide':'金门总兵署游客指南'}</strong> {en?'focuses on one task: helping you plan and understand a complete visit.':'只专注一件事：帮助你把清金门镇总兵署参观好。'}</p><p>{en?'The content follows the real visitor journey in three stages:':'内容按照游客的真实流程组织为三个阶段：'}</p><ul>{[[copy.before,copy.beforeText],[copy.during,copy.duringText],[copy.after,copy.afterText]].map(([title,text])=><li>· <strong>{title}:</strong> {text}</li>)}</ul><h2>{copy.notOfficial}</h2><p>{page.sections.find((x)=>x.title.toLowerCase().includes(en?'official':'官方'))?.text}</p><h2>{copy.trust}</h2><p>{page.sections.at(-1)?.text} <a href={lp('/sources/')}>{en?'Sources':'资料来源'}</a> · <a href={lp('/corrections/')}>{en?'Corrections':'纠错'}</a> · <a href={lp('/credits/')}>{en?'Photo credits':'照片版权'}</a></p><p class="text-sm text-[var(--color-slate)]">{copy.editor} · hello@{site.domain}</p></article></main>}
  {kind === 'corrections' && <main class="container-page py-12"><div class="mx-auto max-w-3xl"><p class="prose-cn">{page.intro}</p><div class="card mt-6"><h2 class="font-serif text-lg font-bold">{copy.report}</h2><ul class="mt-3 space-y-2"><li>· {copy.reportText}: <a class="text-[var(--color-brick)] underline" href={`mailto:update@${site.domain}`}>update@{site.domain}</a></li><li>· {copy.reportHelp}</li></ul></div><h2 class="mt-12 font-serif text-2xl font-bold">{copy.record}</h2><div class="mt-5 rounded-2xl border border-[var(--color-slate-line)] p-6 text-sm">{copy.recordText}</div></div></main>}
  {kind === 'credits' && <main class="container-page py-12"><div class="overflow-x-auto rounded-2xl bg-white shadow-[var(--shadow-card)]"><table class="w-full min-w-[700px] text-sm"><thead><tr class="bg-[var(--color-paper-deep)] text-left">{copy.photoCol.map((item)=><th class="p-4 font-semibold">{item}</th>)}</tr></thead><tbody>{photoCredits.map((item)=><tr class="border-t align-middle"><td class="p-3"><ResponsiveImage src={item.file} alt={item.title} class="h-14 w-20 rounded-lg object-cover" sizes="80px" widths={[80,160]} maxWidth={160}/></td><td class="p-3"><a href={item.source} target="_blank" rel="noopener" class="hover:text-[var(--color-brick)] hover:underline">{item.title}</a></td><td class="p-3">{item.author}</td><td class="p-3"><span class="rounded-full bg-[var(--color-paper-deep)] px-2.5 py-1 text-xs">{item.license}</span></td></tr>)}</tbody></table></div><p class="mt-6 max-w-2xl text-sm leading-7 text-[var(--color-slate)]">{copy.photoNote}</p></main>}
  {kind === 'sources' && <main class="container-page py-12"><div class="mx-auto max-w-3xl"><h2 class="font-serif text-2xl font-bold">{copy.mainSources}</h2><div class="mt-5 space-y-3">{sources.map(([title,url,note])=><a href={url} target="_blank" rel="noopener" class="block rounded-2xl bg-white p-5 shadow-[var(--shadow-card)] transition-transform hover:-translate-y-0.5"><div class="font-medium text-[var(--color-brick)]">{title} ↗</div><p class="mt-1 text-sm">{note}</p></a>)}</div><h2 class="mt-12 font-serif text-2xl font-bold">{copy.levels}</h2><div class="mt-5 space-y-3">{levels.map(([label,desc,tag])=><div class="flex items-center gap-4 rounded-xl bg-white p-4 shadow-[var(--shadow-card)]"><span class:list={['tag',`tag-${tag}`]}>{label}</span><span class="text-sm">{desc}</span></div>)}</div><div class="mt-10 rounded-2xl bg-[var(--color-paper-deep)] p-6 text-sm leading-7">{copy.sourceNote}</div></div></main>}
</Layout>
