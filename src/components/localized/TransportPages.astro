---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import LocationMap from '../LocationMap.astro';
import { localizedPath } from '../../i18n/config';
import type { TranslatedLocale } from '../../i18n/content';
import type { LocalizedFullPage } from '../../i18n/full-pages';
import { attraction } from '../../data/site';

const { locale, page } = Astro.props as { locale: TranslatedLocale; page: LocalizedFullPage };
const en = locale === 'en';
const lp = (path: string) => localizedPath(locale, path);
const kind = page.path === '/transport/' ? 'index' : page.path === '/scooter-parking/' ? 'parking' : page.path === '/transport/e-scooter/' ? 'scooter' : 'origin';
const labels = en ? {
  choose: 'Choose how you are arriving', from: 'Where are you starting?', conclusion: 'The short answer', walk: 'Reach Jincheng, park legally and walk', walkText: 'The headquarters, Mofan Street, the memorial arch, Kuige and old-town food are all close together. Walking is easier than riding through narrow lanes.', parking: 'View the complete parking guide', compare: 'Best option for each visitor', transit: 'Visiting without a scooter', transitTitle: 'Public buses and Taiwan Tourist Shuttle', bus: 'Regular buses to Jincheng', busText: 'Route 3 runs from the airport and Route 7 from Shuitou Pier to Jincheng Bus Station. The headquarters is then about 195 m away. Check live service before departure.', live: 'Kinmen live bus information', shuttle: 'Taiwan Tourist Shuttle', shuttleText: 'Sightseeing routes leave Jincheng for different parts of Kinmen and suit visitors willing to follow fixed times.', shuttleLink: 'Routes and timetables', route: 'Step-by-step route', rental: 'Renting immediately on arrival', rentalLink: 'Compare scooters, electric vehicles and licences', return: 'Return journey', map: 'Open the correct map location', today: 'Current visitor information', quick: 'Short on time? Use the 20-minute route', evening: 'Plan the evening as well', eveningText: 'The headquarters is normally open until 22:00, and registration for the Houpu night tour is at 19:30.', night: 'Night-tour details', vehicles: 'First identify the vehicle', vehicleTitle: 'These three vehicle classes are not interchangeable', type: 'Vehicle', passenger: 'Passengers', use: 'Best use', licence: 'Licence guidance', micro: 'Micro electric two-wheeler', rulesTitle: 'Licence-free does not mean rule-free', suitable: 'Who should rent what?', suitableTitle: 'Decide by group size and weather', stations: 'Where to collect and return', stationsTitle: 'Rental points at Shuitou, the airport and Jincheng', officialRental: 'Official rental information', shared: 'Shared-station announcement', correct: 'The correct final approach', correctTitle: 'Ride to Jincheng → park legally → continue on foot', parkingGuide: 'View parking guide', current: 'A currently documented station', sharedTitle: 'Shared electric scooters: behind Jincheng Township Office', four: 'Four steps when parking', nightParking: 'Parking during the night tour', dynamic: 'Do not rely on a static vacancy count',
} : {
  choose: '选择你的到达方式', from: '你现在从哪里来？', conclusion: '先给结论', walk: '到金城后，停车步行最轻松', walkText: '总兵署、模范街、邱良功母节孝坊、奎阁与附近小吃都集中在步行范围。把车辆停在合法车格后再逛更省事。', parking: '查看完整停车指南', compare: '不同游客怎么选', transit: '不骑车也能玩', transitTitle: '公车与台湾好行', bus: '一般公车到金城车站', busText: '从尚义机场可搭 3 路、从水头码头可搭 7 路前往金城车站；下车后步行约 195 米到总兵署。出发前请查实时信息。', live: '金门公车动态信息', shuttle: '台湾好行环岛景点', shuttleText: '多条观光路线从金城车站出发，适合不骑车、愿意按固定时刻游览的旅客。', shuttleLink: '查看路线与时刻', route: '分步路线', rental: '落地直接租车', rentalLink: '比较机车、电动车与驾照要求', return: '返程', map: '打开正确地点与导航', today: '今日开放信息', quick: '时间紧？走 20 分钟路线', evening: '顺便安排晚上', eveningText: '总兵署开放至 22:00，19:30 可现场报名后浦夜游。', night: '了解夜游', vehicles: '先分清车型', vehicleTitle: '三种车辆不能混为一谈', type: '车辆', passenger: '载人', use: '适合用途', licence: '驾照提示', micro: '微型电动二轮车', rulesTitle: '免机车驾照，不等于没有规则', suitable: '谁适合租', suitableTitle: '按同行人数和天气决定', stations: '在哪里取还车', stationsTitle: '水头、机场与金城市区都有租车点', officialRental: '查看租车业者官方资料', shared: '查看共享站点公告', correct: '到总兵署后的正确动线', correctTitle: '骑到金城 → 合法停车 → 改用步行', parkingGuide: '查看停车指南', current: '目前可确认的站点', sharedTitle: '共享电动机车：金城镇公所后方停车场', four: '现场停车四步', nightParking: '夜游期间车辆停哪里', dynamic: '不要依赖静态空位信息',
};
const choices = en ? [
  ['⛴','From Shuitou Pier','Bus, taxi or collect a rental vehicle','/transport/shuitou-pier/'],['✈','From Kinmen Airport','Bus, taxi or airport vehicle rental','/transport/kinmen-airport/'],['🚶','Staying in Jincheng','About three minutes from the bus station','/transport/jincheng-bus-station/'],['🛵','Scooter or electric vehicle','Classes, licences, sharing and charging','/transport/e-scooter/'],['🅿','Driving a car','Park first, then enter Houpu on foot','/scooter-parking/#car'],['🚌','Public bus','Regular buses and sightseeing routes','#public-transit'],
] : [['⛴','我从水头码头来','公车、出租车或直接取车','/transport/shuitou-pier/'],['✈','我从金门机场来','公车、出租车或机场取车','/transport/kinmen-airport/'],['🚶','我住在金城','金城车站步行约 3 分钟','/transport/jincheng-bus-station/'],['🛵','我骑机车／电动车','车型、驾照、共享与换电','/transport/e-scooter/'],['🅿','我开汽车','停车后步行进入后浦','/scooter-parking/#car'],['🚌','我搭公车','一般公车与台湾好行','#public-transit']];
const compare = en ? [
  ['One person with a flexible island itinerary','Petrol or standard electric scooter'],['Short journeys within Jincheng','Walking, a micro electric two-wheeler or shared scooter'],['Two people touring the island','A vehicle legally approved for two people and the correct licence'],['Children, older visitors or large luggage','Car or taxi'],['Rain, strong wind or summer midday','Car, taxi or bus'],['Only the headquarters and Houpu','Walk after reaching Jincheng'],
] : [['一个人、自由安排景点','燃油或一般电动机车'],['只在金城短程移动','步行、微型电动二轮车或共享电动机车'],['两人环岛','可合法双载且符合驾照资格的机车'],['带孩子、长辈或大件行李','汽车或出租车'],['下雨、强风、夏季正午','汽车、出租车或公车'],['只逛总兵署与后浦','到金城后全程步行']];
const vehicles = en ? [
  ['Micro electric two-wheeler','No passenger','Short trips near Jincheng','No scooter licence; rider must be 14+'],['Standard electric scooter','Approved seating only','Longer cross-island travel','Normally needs the relevant scooter licence'],['Petrol scooter','Approved seating only','Most reliable for long distances','Relevant scooter licence required'],
] : [['微型电动二轮车','不可载人','金城附近短程','免机车驾照；须年满 14 岁'],['一般电动机车','依核定座位','跨乡镇、环岛','通常需相应机车驾照'],['燃油机车','依核定座位','长距离最稳妥','需相应机车驾照']];
const rules = en ? ['Vehicle approval, registration plate and compulsory insurance are required','The rider must be at least 14','Wear an approved helmet throughout','Maximum speed is 25 km/h; illegal modification is prohibited','No passengers, drink-driving or drug-driving'] : ['车辆须完成审验、挂牌并投保强制险','骑乘者须年满 14 岁','全程佩戴合格安全帽','最高时速 25 公里，不得擅自改装','不得载人，也不得酒驾或毒驾'];
const suitable = en ? [['One person, short distance','A shared scooter or micro electric two-wheeler can be convenient.'],['Two people touring','Use a model approved for two people and ensure the rider holds the correct licence.'],['Family, older visitors or luggage','A car or taxi is generally safer and easier.'],['Rain, wind or midday heat','Do not force a ride; switch to a car or bus.']] : [['一个人短程','共享电动机车或微型电动二轮车较轻松。'],['两人环岛','选择核定可双载、且驾驶人具备相应驾照的车型。'],['亲子、长辈、行李多','汽车或出租车通常更安全省力。'],['下雨、强风、正午高温','不要勉强骑行，改搭汽车或公车。']];
const stations = en ? [['Shuitou','No. 20, Sec. 1, Xihai Road','Walk from the ferry terminal'],['Airport','Opposite the coach park at No. 1 Shangyi','Collect immediately after landing'],['Jincheng','No. 38, Sec. 1, Huandao North Road','Useful for town collection and return']] : [['水头站','金城镇西海路一段 20 号','下船后可步行前往'],['机场站','尚义 1 号大客车停车场对面','落地后直接取车'],['金城站','环岛北路一段 38 号','适合市区取还车']];
const origin = page.path.includes('jincheng-bus-station') ? 'station' : 'airport';
const originData = en ? origin === 'station' ? {
  title: 'From Jincheng Bus Station to the headquarters', intro: 'The two sites are about 195 metres apart, normally a three-minute walk.', facts: ['About 195 m','About 3 minutes'], steps: ['Alight at Jincheng Bus Station, the main bus hub for western Kinmen.','Leave towards Wujiang Street and walk about 195 m until the brick-red gate appears.','The route passes through the Houpu old-town area, which is easy to explore afterwards.'], back: 'Return to Jincheng Bus Station for buses to the airport, Shuitou Pier and other attractions.', rental: '',
} : {
  title: 'From Kinmen Airport to the headquarters', intro: 'The airport is about 8 km away; taxi or car usually takes 15–20 minutes.', facts: ['About 8 km','15–20 minutes'], steps: ['Take bus 3 towards Jincheng or use a taxi directly to central Jincheng.','From Jincheng Bus Station, walk about three minutes to the headquarters.','If driving, use a public car park in Jincheng and continue on foot.'], back: 'Allow at least 40–60 minutes for the return: bus 3 from Jincheng or a direct taxi.', rental: 'Scooter rental is available at the airport. Confirm licence eligibility, luggage transfer and return arrangements before booking.',
} : origin === 'station' ? {
  title: '从金城车站到总兵署', intro: '两地约 195 米，正常步行约 3 分钟。', facts: ['约 195 米','约 3 分钟'], steps: ['在金城车站下车，这里是金门西半岛公车枢纽。','出站后沿浯江街方向步行约 195 米，即可看到砖红门楼。','沿途经过后浦老街街区，可顺道逛逛。'], back: '返程同样从金城车站搭乘各线公车，前往机场、水头码头或其他景点。', rental: '',
} : {
  title: '从金门机场到总兵署', intro: '机场距离金城市区约 8 公里，车程通常约 15–20 分钟。', facts: ['约 8 公里','约 15–20 分钟'], steps: ['从尚义机场搭乘 3 路公车前往金城车站，或直接搭出租车。','抵达金城车站后步行约 3 分钟到总兵署。','自驾停入金城公共停车场后再步行进入。'], back: '返回机场建议预留至少 40–60 分钟，可从金城车站搭 3 路公车或出租车。', rental: '机场设有机车租赁服务点。预订前确认驾照资格、行李接送和还车安排。',
};
---

{kind === 'index' && <Layout title={page.title} description={page.description} active="/transport/" pageType="Article"><PageHeader eyebrow={page.eyebrow} crumb={page.title} title={page.title} intro={page.intro}/><div class="container-page py-12"><p class="eyebrow">{labels.choose}</p><h2 class="mt-2 font-serif text-2xl font-bold">{labels.from}</h2><div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{choices.map(([icon,title,meta,href])=><a href={href.startsWith('#')?href:lp(href)} class="group flex items-center gap-4 rounded-2xl bg-white p-5 shadow-[var(--shadow-card)] transition-transform hover:-translate-y-1"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[var(--color-paper-deep)] text-2xl">{icon}</span><span class="flex-1"><span class="block font-serif text-lg font-bold">{title}</span><span class="mt-1 block text-sm">{meta}</span></span><span>→</span></a>)}</div>
  <div class="mt-12 grid gap-6 lg:grid-cols-5"><section class="rounded-2xl bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6 text-white lg:col-span-2 sm:p-8"><p class="text-sm font-semibold text-white/75">{labels.conclusion}</p><h2 class="mt-2 font-serif text-2xl font-black !text-white">{labels.walk}</h2><p class="mt-4 text-sm leading-7 text-white/85">{labels.walkText}</p><a href={lp('/scooter-parking/')} class="mt-6 inline-flex text-sm font-semibold text-white underline">{labels.parking} →</a></section><section class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)] lg:col-span-3"><h2 class="p-5 font-serif text-xl font-bold">{labels.compare}</h2><table class="w-full text-sm"><tbody>{compare.map(([traveler,mode])=><tr class="border-t border-[var(--color-slate-line)]"><th class="p-4 text-left font-medium">{traveler}</th><td class="p-4 font-semibold">{mode}</td></tr>)}</tbody></table></section></div>
  <section id="public-transit" class="mt-12 scroll-mt-24"><p class="eyebrow">{labels.transit}</p><h2 class="mt-2 font-serif text-2xl font-bold">{labels.transitTitle}</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><div class="card"><h3 class="font-serif text-lg font-bold">{labels.bus}</h3><p class="mt-2 text-sm leading-7">{labels.busText}</p><a href="https://bus.kinmen.gov.tw/" target="_blank" class="mt-4 inline-block text-sm text-[var(--color-brick)]">{labels.live} ↗</a></div><div class="card"><h3 class="font-serif text-lg font-bold">{labels.shuttle}</h3><p class="mt-2 text-sm leading-7">{labels.shuttleText}</p><a href="https://kinmen.travel/zh-cn/information/TaiwanTrip" target="_blank" class="mt-4 inline-block text-sm text-[var(--color-brick)]">{labels.shuttleLink} ↗</a></div></div></section><div class="mt-10"><LocationMap/></div></div></Layout>}

{kind === 'origin' && <Layout title={originData.title} description={page.description} active="/transport/" pageType="Article"><PageHeader eyebrow={page.eyebrow} crumb={page.title} title={originData.title} intro={originData.intro}><div class="mt-5 flex gap-4 text-sm"><span class="rounded-full bg-white px-4 py-2">📍 {originData.facts[0]}</span><span class="rounded-full bg-white px-4 py-2">⏱ {originData.facts[1]}</span></div></PageHeader><div class="container-page py-12"><div class="mx-auto max-w-3xl"><h2 class="font-serif text-2xl font-bold">{labels.route}</h2><ol class="mt-5 space-y-4">{originData.steps.map((step,index)=><li class="flex gap-4 rounded-2xl bg-white p-5 shadow-[var(--shadow-card)]"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full step-num text-sm font-bold">{index+1}</span><span class="leading-8">{step}</span></li>)}</ol>{originData.rental&&<div class="mt-8 rounded-2xl border bg-white p-6"><div class="text-sm font-semibold text-[var(--color-brick)]">{labels.rental}</div><p class="mt-2 text-sm leading-7">{originData.rental}</p><a href={lp('/transport/e-scooter/')} class="mt-4 inline-block text-sm text-[var(--color-brick)]">{labels.rentalLink} →</a></div>}<div class="mt-8 rounded-2xl bg-[var(--color-paper-deep)] p-6"><h3 class="font-serif text-lg font-bold">{labels.return}</h3><p class="mt-2 leading-8">{originData.back}</p></div><div class="mt-8 flex flex-wrap gap-3"><a href={attraction.googleMapsUrl} target="_blank" class="btn btn-primary">↗ {labels.map}</a><a href={lp('/visit/')} class="btn btn-secondary">{labels.today}</a><a href={lp('/routes/20-minute/')} class="btn btn-secondary">{labels.quick}</a></div><div class="mt-8 rounded-2xl border p-5 text-sm"><strong>{labels.evening}:</strong> {labels.eveningText} <a class="text-[var(--color-brick)] underline" href={lp('/houpu-night-walk/')}>{labels.night} →</a></div></div></div></Layout>}

{kind === 'scooter' && <Layout title={page.title} description={page.description} active="/transport/" pageType="Article"><PageHeader eyebrow={page.eyebrow} crumb={page.title} title={page.title} intro={page.intro}/><div class="container-page py-12"><section><p class="eyebrow">{labels.vehicles}</p><h2 class="mt-2 font-serif text-2xl font-bold">{labels.vehicleTitle}</h2><div class="mt-5 overflow-x-auto rounded-2xl bg-white shadow-[var(--shadow-card)]"><table class="w-full min-w-[680px] text-sm"><thead><tr class="bg-[var(--color-paper-deep)] text-left">{[labels.type,labels.passenger,labels.use,labels.licence].map((x)=><th class="p-4">{x}</th>)}</tr></thead><tbody>{vehicles.map((row)=><tr class="border-t">{row.map((cell,index)=><td class:list={['p-4',index===0?'font-bold':'']}>{cell}</td>)}</tr>)}</tbody></table></div></section><div class="mt-12 grid gap-6 lg:grid-cols-2"><section class="card"><p class="eyebrow">{labels.micro}</p><h2 class="mt-2 font-serif text-xl font-bold">{labels.rulesTitle}</h2><ul class="mt-5 space-y-3 text-sm leading-7">{rules.map((rule)=><li class="flex gap-3"><span class="text-[var(--color-brick)]">●</span>{rule}</li>)}</ul></section><section class="rounded-2xl bg-[var(--color-paper-deep)] p-6 sm:p-8"><p class="eyebrow">{labels.suitable}</p><h2 class="mt-2 font-serif text-xl font-bold">{labels.suitableTitle}</h2><div class="mt-5 space-y-4 text-sm leading-7">{suitable.map(([who,text])=><p><strong>{who}:</strong> {text}</p>)}</div></section></div><section class="mt-12"><p class="eyebrow">{labels.stations}</p><h2 class="mt-2 font-serif text-2xl font-bold">{labels.stationsTitle}</h2><div class="mt-5 grid gap-5 md:grid-cols-3">{stations.map(([name,address,note])=><article class="card"><h3 class="font-serif text-lg font-bold">{name}</h3><p class="mt-2 text-sm">{address}</p><p class="mt-3 text-xs text-[var(--color-slate)]">{note}</p></article>)}</div><div class="mt-5 rounded-2xl border bg-white p-6 text-sm leading-7">{page.sections[3].text}</div><div class="mt-5 flex gap-3"><a href="https://kinmen.travel/zh-tw/shop/details/2889" target="_blank" class="btn btn-primary">{labels.officialRental} ↗</a><a href="https://kinmen.travel/zh-tw/news/details/3535" target="_blank" class="btn btn-secondary">{labels.shared} ↗</a></div></section><section class="mt-12 rounded-2xl bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6 text-white sm:p-8"><p class="text-sm text-white/75">{labels.correct}</p><h2 class="mt-2 font-serif text-2xl font-black !text-white">{labels.correctTitle}</h2><p class="mt-3 text-sm leading-7 text-white/85">{page.sections[4].text}</p><a href={lp('/scooter-parking/')} class="mt-6 inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[var(--color-brick)]">{labels.parkingGuide} →</a></section></div></Layout>}

{kind === 'parking' && <Layout title={page.title} description={page.description} active="/transport/" pageType="Article"><PageHeader eyebrow={page.eyebrow} crumb={page.title} title={page.title} intro={page.intro}/><div class="container-page py-12"><section class="grid gap-5 md:grid-cols-3">{[['🛵',page.sections[0]],['⚡',page.sections[1]],['🚗',page.sections[2]]].map(([icon,section]:any)=><article class="card"><span class="text-2xl">{icon}</span><h2 class="mt-3 font-serif text-xl font-bold">{section.title}</h2><p class="mt-2 text-sm leading-7">{section.text}</p></article>)}</section><div class="mt-12 grid gap-8 lg:grid-cols-3"><main class="space-y-8 lg:col-span-2"><section><p class="eyebrow">{labels.current}</p><h2 class="mt-2 font-serif text-2xl font-bold">{labels.sharedTitle}</h2><p class="mt-4 text-sm leading-8">{en?'One of the six shared rental stations announced in 2025 is behind Jincheng Township Office. It is a shared-vehicle return point, not a general parking entitlement. Check the operator app for current availability.':'2025 年官方公告的 6 处共享租还点之一位于金城镇公所后方停车场。共享专用租还点不代表所有车辆都能停入，实际车位以 App 当下显示为准。'}</p></section><section class="rounded-2xl bg-[var(--color-paper-deep)] p-6 sm:p-8"><h2 class="font-serif text-xl font-bold">{labels.four}</h2><ol class="mt-5 space-y-4 text-sm leading-7">{(en?['Read signs and ground markings before choosing a bay.','Keep entrances, shopfronts, fire access and pedestrian routes clear.','For a shared vehicle, confirm in the app that the return and billing have ended.','Photograph the location so it is easy to find after the old-town walk.']:['先看标志与地面标线，确认汽车格、普通机车格或共享专用格。','不要挡住景点出入口、店家门口、消防通道与行人动线。','共享车辆在 App 完成还车并确认计费停止后再离开。','拍下停车位置，逛完模范街或夜游后容易返回取车。']).map((x,i)=><li class="flex gap-3"><strong class="text-[var(--color-brick)]">{i+1}.</strong>{x}</li>)}</ol></section><section><h2 class="font-serif text-2xl font-bold">{labels.nightParking}</h2><p class="mt-3 text-sm leading-8">{en?'The 19:30 walk begins at the headquarters and ends on Mofan Street. Leave the vehicle in a legal space, then walk back after the tour. Check closing times and temporary traffic controls.':'19:30 后浦夜游从总兵署出发、在模范街结束。车辆留在合法车格，结束后步行返回取车，并留意停车场关闭时间与临时交通管制。'}</p></section><section class="rounded-2xl border bg-white p-6"><h2 class="font-serif text-xl font-bold">{labels.dynamic}</h2><p class="mt-2 text-sm leading-7">{en?'Parking supply and restrictions change during events. Follow signs, markings and staff instructions on arrival.':'停车格和管制会随活动调整，到现场仍以标志、标线及管理人员指示为准。'}</p><a href="https://kmpark.guoyun.com.tw/" target="_blank" class="mt-4 inline-block text-sm text-[var(--color-brick)]">Kinmen parking information ↗</a></section></main><aside><LocationMap compact/></aside></div><div class="mt-10 flex gap-3"><a href={lp('/transport/e-scooter/')} class="btn btn-primary">{labels.vehicleTitle} →</a><a href={lp('/nearby/')} class="btn btn-secondary">{labels.walk} →</a></div></div></Layout>}
