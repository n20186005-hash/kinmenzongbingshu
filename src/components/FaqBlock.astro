---
import type { FaqItem } from '../lib/faq';

interface Props {
  items: FaqItem[];
  eyebrow?: string;
  heading?: string;
  id?: string;
  class?: string;
}

const {
  items,
  eyebrow = '常見問題',
  heading = '出發前先看看',
  id = 'faq',
  class: className = '',
} = Astro.props;
---

{items.length > 0 && (
  <section id={id} class={`container-page scroll-mt-24 ${className}`}>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-2 text-2xl sm:text-3xl">{heading}</h2>
    <div class="mt-6 divide-y divide-[var(--color-slate-line)] overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
      {items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-medium text-[var(--color-ink)]">
            {item.q}
            <span class="text-[var(--color-brick)] transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="px-5 pb-5 text-sm leading-7 text-[var(--color-wood-soft)]">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
