---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultSocialImage from '../assets/images/hero-exterior.jpg';
import SourcesSection from '../components/SourcesSection.astro';
import { site, attraction, googleRating } from '../data/site';
import {
  getLanguageAlternates,
  getLocaleFromPath,
  localeConfig,
  localeUi,
  localizedAttraction,
  localizedPath,
  stripLocalePrefix,
} from '../i18n/config';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  active?: string;
  canonicalPath?: string;
  pageType?: 'WebPage' | 'Article';
  breadcrumbs?: Breadcrumb[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  preloadImage?: ImageMetadata;
  preloadWidths?: number[];
  preloadSizes?: string;
}
const {
  title,
  description: providedDescription,
  active,
  canonicalPath,
  pageType = 'WebPage',
  breadcrumbs,
  structuredData,
  noindex = false,
  preloadImage,
  preloadWidths = [320, 480, 640, 960, 1280, 1600],
  preloadSizes = '100vw',
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const localeMeta = localeConfig[locale];
const ui = localeUi[locale];
const localAttraction = localizedAttraction[locale];
const basePath = stripLocalePrefix(Astro.url.pathname);
const description = providedDescription ?? ui.defaultDescription;
const fullTitle = basePath === '/' ? ui.homeTitle : `${title}｜${ui.titleSuffix}`;
const languageAlternates = getLanguageAlternates(Astro.url.pathname);
const localeHomePath = localizedPath(locale, '/');
const localeNav = ui.nav.map(([label, path]) => ({ label, path, href: localizedPath(locale, path) }));
const primaryNavPaths = new Set(['/map/', '/highlights/', '/transport/', '/nearby/']);
const headerPrimaryNav = localeNav.filter((item) => primaryNavPaths.has(item.path));
const headerMoreNav = localeNav.filter((item) => item.path !== '/visit/' && !primaryNavPaths.has(item.path));
const moreIsActive = headerMoreNav.some((item) => active === item.path);
const localeFooterNav = ui.footerNav.map(([label, path]) => ({ label, href: localizedPath(locale, path) }));
const localeBottomNav = ui.bottomNav.map((item) => {
  const isExternal = 'external' in item && item.external === true;
  return {
    label: item.label,
    icon: item.icon,
    href: isExternal ? item.href : localizedPath(locale, item.href),
    external: isExternal,
  };
});

const baseUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, baseUrl).href;
const homeUrl = new URL('/', baseUrl).href;
const publisherId = `${homeUrl}#publisher`;
const websiteId = `${homeUrl}#website`;
const attractionId = `${homeUrl}#attraction`;
const pageId = `${canonicalUrl}#webpage`;
const socialImageResult = await getImage({
  src: defaultSocialImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
const socialImageUrl = new URL(socialImageResult.src, baseUrl).href;

const attractionLdDescription = locale === 'en'
  ? `Comprehensive visitor guide to ${localAttraction.name} in ${localAttraction.addressLocality}, ${localAttraction.addressRegion}, ${localAttraction.addressCountry} — location map, opening details, nearby landmarks and travel tips.`
  : locale === 'zh-Hans'
    ? '清金门镇总兵署（浯江新庄）完整游客指南：位于金门县金城镇，收录开放时间、位置地图、周边地标、交通方式与旅游建议。'
    : '清金門鎮總兵署（浯江新莊）完整遊客指南：座落金門縣金城鎮，收錄開放時間、位置地圖、周邊地標、交通方式與旅遊建議。';

const preloadResult = preloadImage
  ? await getImage({
      src: preloadImage,
      width: Math.min(1600, preloadImage.width),
      widths: preloadWidths.filter((width) => width <= preloadImage.width),
      format: 'webp',
      quality: 80,
    })
  : undefined;

const defaultBreadcrumbs: Breadcrumb[] = basePath === '/'
  ? [{ name: ui.home, path: localeHomePath }]
  : [{ name: ui.home, path: localeHomePath }, { name: title, path: Astro.url.pathname }];
const breadcrumbItems = breadcrumbs ?? defaultBreadcrumbs;

const extraStructuredData = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData]).map(({ ['@context']: _, ...node }) => node)
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': publisherId,
      name: ui.brand,
      alternateName: ui.subtitle,
      url: homeUrl,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl,
      name: ui.brand,
      alternateName: site.brandEn,
      inLanguage: localeMeta.htmlLang,
      publisher: { '@id': publisherId },
    },
    {
      '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings', 'Museum'],
      '@id': attractionId,
      name: localAttraction.name,
      alternateName: [attraction.nameEn, attraction.googleNameEn, ...localAttraction.aliases],
      description: attractionLdDescription,
      url: homeUrl,
      image: [socialImageUrl],
      isAccessibleForFree: true,
      publicAccess: true,
      address: {
        '@type': 'PostalAddress',
        streetAddress: localAttraction.address,
        addressLocality: localAttraction.addressLocality,
        addressRegion: localAttraction.addressRegion,
        postalCode: localAttraction.postalCode,
        addressCountry: localAttraction.addressCountry,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: attraction.coordinates.lat,
        longitude: attraction.coordinates.lng,
      },
      hasMap: attraction.mapsShareUrl,
      openingHours: `Mo-Su ${attraction.openingHours.opens}-${attraction.openingHours.closes}`,
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [
            'https://schema.org/Monday',
            'https://schema.org/Tuesday',
            'https://schema.org/Wednesday',
            'https://schema.org/Thursday',
            'https://schema.org/Friday',
            'https://schema.org/Saturday',
            'https://schema.org/Sunday',
          ],
          opens: attraction.openingHours.opens,
          closes: attraction.openingHours.closes,
        },
      ],
      telephone: attraction.phoneInternational,
      sameAs: [attraction.mapsShareUrl, attraction.govtTourismUrl],
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: googleRating.value,
        reviewCount: googleRating.count,
        bestRating: googleRating.best,
        worstRating: googleRating.worst,
        url: googleRating.sourceUrl,
      },
    },
    {
      '@type': pageType,
      '@id': pageId,
      url: canonicalUrl,
      name: fullTitle,
      ...(pageType === 'Article' ? { headline: title, dateModified: site.verifiedAt } : {}),
      description,
      inLanguage: localeMeta.htmlLang,
      isPartOf: { '@id': websiteId },
      about: { '@id': attractionId },
      mainEntityOfPage: canonicalUrl,
      author: { '@id': publisherId },
      publisher: { '@id': publisherId },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, baseUrl).href,
      })),
    },
    ...extraStructuredData,
  ],
};
---
<!doctype html>
<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {languageAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.path, baseUrl).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, baseUrl).href} />
    <meta property="og:type" content={pageType === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={ui.brand} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {languageAlternates.filter((alternate) => alternate.locale !== locale).map((alternate) => (
      <meta property="og:locale:alternate" content={localeConfig[alternate.locale].ogLocale} />
    ))}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={localAttraction.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {preloadResult && (
      <link
        rel="preload"
        as="image"
        href={preloadResult.src}
        imagesrcset={preloadResult.srcSet.attribute}
        imagesizes={preloadSizes}
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%239a3b2e'/%3E%3Cpath d='M6 22h20M8 22V13l8-5 8 5v9M16 22v-6' stroke='%23f7f1e6' stroke-width='1.6' fill='none' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#9a3b2e" />
    <meta name="application-name" content={ui.brand} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={ui.brandShort} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="pb-16 md:pb-0">
    <!-- 頂部導航 -->
    <header class="sticky top-0 z-40 border-b border-[var(--color-slate-line)] bg-[var(--color-paper)]/90 backdrop-blur">
      <div class="container-page flex h-16 items-center justify-between gap-3">
        <a href={localeHomePath} class="flex min-w-0 shrink-0 items-center gap-2.5" aria-label={ui.home}>
          <span class="grid h-9 w-9 place-items-center rounded-lg" style="background:var(--color-brick)">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M6 23h20M8 23V13l8-5 8 5v10M16 23v-6" stroke="#f7f1e6" stroke-width="1.7" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="leading-tight">
            <span class:list={['block whitespace-nowrap font-serif font-bold text-[var(--color-ink)]', locale === 'en' ? 'text-sm xl:text-base' : 'text-base']}>{ui.brandShort}</span>
          </span>
        </a>
        <nav class="hidden items-center gap-0.5 lg:flex" aria-label={locale === 'en' ? 'Main navigation' : '主導航'}>
          {headerPrimaryNav.map((item) => (
            <a
              href={item.href}
              class:list={['rounded-full px-2.5 py-2 text-sm font-medium transition-colors hover:bg-[var(--color-paper-deep)]', active === item.path ? 'bg-[var(--color-paper-deep)] text-[var(--color-brick)]' : 'text-[var(--color-wood-soft)]']}
            >{item.label}</a>
          ))}
          <details class="group relative">
            <summary class:list={['flex cursor-pointer list-none items-center gap-1 rounded-full px-2.5 py-2 text-sm font-medium transition-colors hover:bg-[var(--color-paper-deep)]', moreIsActive ? 'bg-[var(--color-paper-deep)] text-[var(--color-brick)]' : 'text-[var(--color-wood-soft)]']}>
              {ui.more}
              <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="absolute right-0 top-11 z-50 min-w-44 overflow-hidden rounded-xl border border-[var(--color-slate-line)] bg-white py-1 shadow-[var(--shadow-card)]">
              {headerMoreNav.map((item) => (
                <a href={item.href} class:list={['block px-4 py-2.5 text-sm hover:bg-[var(--color-paper-deep)]', active === item.path ? 'font-semibold text-[var(--color-brick)]' : 'text-[var(--color-wood-soft)]']}>{item.label}</a>
              ))}
            </div>
          </details>
        </nav>
        <div class="flex items-center gap-2">
          {languageAlternates.length > 1 && (
            <details class="relative hidden sm:block">
              <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-[var(--color-slate-line)] bg-white px-3 py-2 text-xs font-medium text-[var(--color-wood-soft)] hover:bg-[var(--color-paper-deep)]" aria-label={ui.language}>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor"/><path d="M2.5 8h11M8 2c1.6 1.7 2.4 3.7 2.4 6S9.6 12.3 8 14M8 2C6.4 3.7 5.6 5.7 5.6 8s.8 4.3 2.4 6" stroke="currentColor"/></svg>
                <span class="hidden lg:inline">{ui.currentLanguage}</span>
                <span class="lg:hidden">{localeMeta.shortLabel}</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="absolute right-0 top-11 z-50 min-w-28 overflow-hidden rounded-xl border border-[var(--color-slate-line)] bg-white py-1 shadow-[var(--shadow-card)]">
                {languageAlternates.map((alternate) => (
                  <a href={alternate.path} lang={localeConfig[alternate.locale].htmlLang} class:list={['block px-4 py-2 text-sm hover:bg-[var(--color-paper-deep)]', alternate.locale === locale ? 'font-bold text-[var(--color-brick)]' : 'text-[var(--color-wood-soft)]']}>{alternate.label}</a>
                ))}
              </div>
            </details>
          )}
          <a href={localizedPath(locale, '/visit/')} class="btn btn-primary hidden whitespace-nowrap px-4 py-2 text-sm sm:inline-flex xl:px-5">{ui.start}</a>
          <button id="menuBtn" class="grid h-10 w-10 place-items-center rounded-lg border border-[var(--color-slate-line)] lg:hidden" aria-label={ui.menu} aria-controls="mobileMenu" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
      <!-- 移動端下拉 -->
      <div id="mobileMenu" class="hidden border-t border-[var(--color-slate-line)] bg-[var(--color-paper)] lg:hidden">
        <nav class="container-page grid grid-cols-2 gap-1 py-3">
          {localeNav.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-wood-soft)] hover:bg-[var(--color-paper-deep)]">{item.label}</a>
          ))}
          {languageAlternates.length > 1 && languageAlternates.map((alternate) => (
            <a href={alternate.path} lang={localeConfig[alternate.locale].htmlLang} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-brick)] hover:bg-[var(--color-paper-deep)]">{ui.language} · {alternate.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <SourcesSection />

    <!-- 頁尾 -->
    <footer class="mt-20 border-t border-[var(--color-slate-line)] bg-[var(--color-paper-deep)]">
      <div class="container-page py-12">
        <div class="grid gap-8 md:grid-cols-4">
          <div class="md:col-span-2">
            <div class="font-serif text-lg font-bold text-[var(--color-ink)]">{ui.brand}</div>
            <div class="mt-1 text-[11px] tracking-wide text-[var(--color-slate)]">{ui.subtitle}</div>
            <p class="mt-3 max-w-md text-sm leading-7 text-[var(--color-wood-soft)]">{ui.independentNotice}</p>
            <p class="mt-3 text-xs text-[var(--color-slate)]"><a href={attraction.googleMapsUrl} target="_blank" rel="noopener" class="hover:text-[var(--color-brick)] hover:underline">{localAttraction.address} ↗</a></p>
          </div>
          <div>
            <div class="mb-3 text-sm font-semibold text-[var(--color-ink)]">{ui.start}</div>
            <ul class="space-y-2 text-sm text-[var(--color-wood-soft)]">
              {localeFooterNav.map((item) => <li><a class="hover:text-[var(--color-brick)]" href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div>
            <div class="mb-3 text-sm font-semibold text-[var(--color-ink)]">{ui.language}</div>
            <ul class="space-y-2 text-sm text-[var(--color-wood-soft)]">
              {languageAlternates.map((alternate) => <li><a class="hover:text-[var(--color-brick)]" href={alternate.path} lang={localeConfig[alternate.locale].htmlLang}>{alternate.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-[var(--color-slate-line)] pt-6 text-xs text-[var(--color-slate)]">
          © 2026 {site.domain} · {ui.copyright}
        </div>
      </div>
    </footer>

    <!-- 移動端底部導航（現場最常用的即時動作） -->
    <nav class="fixed bottom-0 left-0 right-0 z-40 grid grid-cols-5 border-t border-[var(--color-slate-line)] bg-[var(--color-paper)]/95 backdrop-blur md:hidden" aria-label={locale === 'en' ? 'Quick actions' : '快速功能'}>
      {localeBottomNav.map((item) => (
        <a
          href={item.href}
          {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
          class="flex min-w-0 flex-col items-center gap-0.5 px-1 py-2 text-[10px] font-medium text-[var(--color-wood-soft)]"
        >
          <span class="text-[var(--color-brick)]">
            {item.icon === 'navigate' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2 4 20l8-4 8 4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
            {item.icon === 'moon' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
            {item.icon === 'bus' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="5" y="4" width="14" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M5 11h14M8.5 20v-3M15.5 20v-3M8 13.5h.01M16 13.5h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
            {item.icon === 'play' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>}
            {item.icon === 'map' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 4L4 6v14l5-2 6 2 5-2V4l-5 2-6-2zM9 4v14M15 6v14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
          </span>
          <span class="w-full truncate text-center">{item.label}</span>
        </a>
      ))}
    </nav>

    <script>
      const btn = document.getElementById('menuBtn');
      const menu = document.getElementById('mobileMenu');
      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(isOpen));
      });
    </script>
    <!-- PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
