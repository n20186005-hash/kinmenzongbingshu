---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { faqPageLd } from '../../lib/faq';
import { transport, attraction, nightWalk } from '../../data/site';

export function getStaticPaths() {
  return transport.map((t) => ({ params: { origin: t.id }, props: { t } }));
}
const { t } = Astro.props;
const mapUrl = attraction.googleMapsUrl;

const detail: Record<string, { steps: string[]; back: string; rental?: string }> = {
  'jincheng-bus-station': {
    steps: [
      '在金城車站下車，這是金門西半島的公車樞紐。',
      '出站後沿浯江街方向步行，約 195 米、3 分鐘即可看到總兵署磚紅門樓。',
      '沿途會經過後浦老街街區，可順道逛逛。',
    ],
    back: '返程同樣從金城車站搭乘各線公車，前往機場、水頭碼頭或其他景點。',
  },
  'kinmen-airport': {
    steps: [
      '從尚義機場搭乘 3 路公車前往金城車站，或直接搭出租車至金城市區。',
      '公車車程約 15–20 分鐘，抵達金城車站後步行約 3 分鐘到總兵署。',
      '自駕則約 15 分鐘，停金城公有停車場後步行進入。',
    ],
    back: '返回機場建議預留至少 40–60 分鐘：金城車站搭 3 路公車，或搭出租車直達。',
    rental: '機場設有機車租賃服務點。若準備環島，可落地取電動或燃油機車；攜帶大件行李者，優先選擇有行李接送的業者，抵達金城後先合法停車再步行參觀。',
  },
  'shuitou-pier': {
    steps: [
      '小三通旅客在水頭碼頭入境後，搭乘 7 路公車前往金城車站。',
      '車程約 12–15 分鐘，抵達金城車站後步行約 3 分鐘到總兵署。',
      '也可在碼頭搭出租車直達金城市區。',
    ],
    back: '返回水頭碼頭搭乘 7 路公車，或搭出租車。趕船請預留充裕時間，班次有限。',
    rental: '水頭旅運中心附近有電動與燃油機車租賃點，部分業者提供甲地租、乙地還及行李接送。取車前先確認駕照資格、還車站點和末班船時間。',
  },
};
const d = detail[t.id];

// 標題直接對應實際搜尋字詞（金城車站到機場公車、金門機場到金城車站公車、水頭碼頭公車）
const seo: Record<string, { title: string; description: string }> = {
  'jincheng-bus-station': {
    title: '金門金城車站交通｜到總兵署、機場與水頭碼頭公車',
    description: '金門金城車站（常簡稱金城站）是後浦主要公車樞紐：到總兵署步行約 195 米、3 分鐘，也整理前往金門機場與水頭碼頭的公車方向、返程與轉乘。',
  },
  'kinmen-airport': {
    title: '金門機場↔金城車站公車｜3 路、時間與返程攻略',
    description: '金門機場到金城車站可搭 3 路公車，車程約 15–20 分鐘；也整理金城車站到機場的返程方式、預留時間、計程車與機場租車提醒。',
  },
  'shuitou-pier': {
    title: '水頭碼頭↔金城車站公車｜7 路、時間與小三通轉乘',
    description: '水頭碼頭到金城車站可搭 7 路公車，車程約 12–15 分鐘；也整理金城到水頭碼頭返程、小三通趕船時間、碼頭租車與計程車方式。',
  },
};

const faqs: Record<string, { q: string; a: string }[]> = {
  'jincheng-bus-station': [
    { q: '金門金城車站、金城車站和金城站是同一個地方嗎？', a: '旅客搜尋時常把金門的「金城車站」簡稱為「金城站」。本站所說的金城車站，指的就是後浦一帶主要公車轉乘樞紐。' },
    { q: '金城車站到總兵署要走多久？', a: '約 195 米、3 分鐘以內。出站沿浯江街方向走，很快就會看到總兵署的磚紅門樓。' },
    { q: '金城車站可以搭車去機場和水頭碼頭嗎？', a: '可以。金城車站是金門西半島的公車樞紐，往尚義機場與水頭碼頭都在這裡轉乘；出發前請以金門公車動態資訊確認當日班次。' },
    { q: '金城車站到機場公車怎麼搭？', a: '可由金城車站搭 3 路往尚義機場方向。班距會依日期與時段調整，趕飛機時不要只按行車時間倒推，請另留候車與報到緩衝。' },
    { q: '金城車站到水頭碼頭公車怎麼搭？', a: '可由金城車站搭 7 路往水頭碼頭方向。若要搭小三通船班，建議把候車、行車與通關時間一起算進去。' },
    { q: '晚上從金城車站還能回得了住處嗎？', a: '總兵署開放至 22:00，回程請先確認末班公車時間；夜間建議改搭計程車或自駕，並預留步行回站時間。' },
  ],
  'kinmen-airport': [
    { q: '金門機場到金城車站公車幾號？要多久？', a: '搭 3 路公車往金城，車程約 15–20 分鐘；抵達金城車站後步行約 3 分鐘就是總兵署。班距依平假日與時段不同，出發前請查公車動態。' },
    { q: '從金門機場到總兵署搭計程車要多久？', a: '車程約 15 分鐘（約 8 公里），是最省時的選擇；行李較多或帶長輩同行時建議直接搭車進金城市區。' },
    { q: '金城車站到金門機場公車怎麼搭？', a: '可在金城車站搭 3 路往尚義機場方向。班次依日期與時段調整，出發前請查即時公車資訊。' },
    { q: '回機場要預留多少時間？', a: '建議至少 40–60 分鐘，含還車、加油、候車與報到。不要只用地圖上的行車時間倒推，尖峰時段或假日請再多留緩衝。' },
  ],
  'shuitou-pier': [
    { q: '水頭碼頭到金城車站公車幾號？要多久？', a: '搭 7 路公車往金城車站，車程約 12–15 分鐘，抵達後再步行約 3 分鐘到總兵署。' },
    { q: '趕船要預留多少時間？', a: '請預留候車與通關時間，班次有限且會受天候影響；行程不要只按地圖車程倒推。' },
    { q: '金城車站到水頭碼頭公車怎麼搭？', a: '可搭 7 路往水頭碼頭方向。若要銜接小三通船班，請額外預留候車與通關時間，並在出發前確認當日班次。' },
    { q: '碼頭可以直接租車嗎？', a: '水頭旅運中心附近有電動與燃油機車租賃點，部分業者提供甲租乙還與行李接送。取車前先確認駕照資格、還車站點與末班船時間。' },
  ],
};

const copy = seo[t.id];
const faqItems = faqs[t.id] ?? [];
const faqLd = faqItems.length ? faqPageLd(faqItems) : undefined;
const pageHeading = t.id === 'jincheng-bus-station'
  ? '金門金城車站交通：到總兵署、機場與水頭碼頭'
  : `從${t.from}到總兵署`;
---
<Layout title={copy.title} description={copy.description} active="/transport/" structuredData={faqLd}>
  <PageHeader eyebrow="交通路線" crumb="交通"
    title={pageHeading}
    intro={t.desc}>
    <div class="mt-5 flex gap-4 text-sm text-[var(--color-wood)]">
      <span class="rounded-full bg-white px-4 py-2">📍 {t.dist}</span>
      <span class="rounded-full bg-white px-4 py-2">⏱ {t.minutes}</span>
    </div>
  </PageHeader>

  <div class="container-page py-12">
    <div class="mx-auto max-w-3xl">
      {t.id === 'jincheng-bus-station' && (
        <section class="mb-10 rounded-2xl bg-[var(--color-paper-deep)] p-6 sm:p-8">
          <p class="eyebrow">金城交通樞紐</p>
          <h2 class="mt-2 font-serif text-2xl font-bold text-[var(--color-ink)]">到後浦先認識金城車站</h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-wood-soft)]">
            金城車站是遊客在金城、後浦一帶最常使用的公車轉乘點。只逛總兵署與後浦時，下車後直接步行最省事；
            要往尚義機場或水頭碼頭，也可從這裡轉乘對應公車。
          </p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <a href="/visit/" class="rounded-xl bg-white p-4 shadow-[var(--shadow-card)]">
              <div class="text-xs text-[var(--color-slate)]">到總兵署</div>
              <div class="mt-1 font-serif text-lg font-bold text-[var(--color-ink)]">步行約 3 分鐘</div>
            </a>
            <a href="/transport/kinmen-airport/" class="rounded-xl bg-white p-4 shadow-[var(--shadow-card)]">
              <div class="text-xs text-[var(--color-slate)]">到金門機場</div>
              <div class="mt-1 font-serif text-lg font-bold text-[var(--color-ink)]">查看 3 路公車 →</div>
            </a>
            <a href="/transport/shuitou-pier/" class="rounded-xl bg-white p-4 shadow-[var(--shadow-card)]">
              <div class="text-xs text-[var(--color-slate)]">到水頭碼頭</div>
              <div class="mt-1 font-serif text-lg font-bold text-[var(--color-ink)]">查看 7 路公車 →</div>
            </a>
          </div>
        </section>
      )}

      <h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">分步路線</h2>
      <ol class="mt-5 space-y-4">
        {d.steps.map((s, i) => (
          <li class="flex gap-4 rounded-2xl bg-white p-5 shadow-[var(--shadow-card)]">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full step-num text-sm font-bold">{i + 1}</span>
            <span class="leading-8 text-[var(--color-wood-soft)]">{s}</span>
          </li>
        ))}
      </ol>

      {d.rental && (
        <div class="mt-8 rounded-2xl border border-[var(--color-slate-line)] bg-white p-6">
          <div class="text-sm font-semibold text-[var(--color-brick)]">落地直接租車</div>
          <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{d.rental}</p>
          <a href="/transport/e-scooter/" class="mt-4 inline-block text-sm font-medium text-[var(--color-brick)] hover:underline">比較機車、電動車與駕照要求 →</a>
        </div>
      )}

      <div class="mt-8 rounded-2xl bg-[var(--color-paper-deep)] p-6">
        <h3 class="font-serif text-lg font-bold text-[var(--color-ink)]">返程</h3>
        <p class="mt-2 leading-8 text-[var(--color-wood-soft)]">{d.back}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={mapUrl} target="_blank" rel="noopener" class="btn btn-primary">↗ 開啟正確地點與導航</a>
        <a href="/visit/" class="btn btn-secondary">今日開放資訊</a>
        <a href="/routes/20-minute/" class="btn btn-secondary">時間緊？走 20 分鐘路線</a>
      </div>

      <div class="mt-8 rounded-2xl border border-[var(--color-slate-line)] p-5 text-sm text-[var(--color-wood-soft)]">
        <strong class="text-[var(--color-ink)]">順便安排晚上：</strong>
        總兵署開放至 22:00，{nightWalk.time} 可在署內現場報名後浦夜遊，
        <a class="text-[var(--color-brick)] underline" href="/houpu-night-walk/">瞭解夜遊 →</a>
      </div>
    </div>
  </div>

  <FaqBlock items={faqItems} eyebrow="路線常見問題" heading={`從${t.from}出發的常見疑問`} id="route-faq" class="pb-16" />
</Layout>
