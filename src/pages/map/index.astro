---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getImage } from 'astro:assets';
import { getLocalImage } from '../../lib/images';
import { rooms } from '../../data/site';

// 平面圖上每個點位的座標（原創示意圖，非精確測繪）
const plan: Record<string, { x: number; y: number }> = {
  'main-gate':       { x: 150, y: 470 },
  'front-courtyard': { x: 150, y: 400 },
  'side-offices':    { x: 60,  y: 330 },
  'main-hall':       { x: 150, y: 320 },
  'passage-hall':    { x: 150, y: 250 },
  'inner-office':    { x: 150, y: 190 },
  'residence':       { x: 150, y: 130 },
  'exhibits':        { x: 245, y: 250 },
  'kapok-tree':      { x: 150, y: 60 },
};
const roomViews = await Promise.all(rooms.map(async (room) => {
  const source = getLocalImage(room.image);
  const outputWidth = Math.min(960, source.width);
  const output = await getImage({
    src: source,
    width: outputWidth,
    widths: [480, 720, 960].filter((width) => width <= outputWidth),
    format: 'webp',
    quality: 80,
  });

  return {
    ...room,
    imageUrl: output.src,
    imageSrcSet: output.srcSet.attribute,
    imageWidth: output.attributes.width,
    imageHeight: output.attributes.height,
  };
}));
const roomsJson = JSON.stringify(roomViews);

// 我現在在哪裡
const whereAmI = [
  { hint: '我在紅色大門前', id: 'main-gate' },
  { hint: '我在開闊的石埕庭院', id: 'front-courtyard' },
  { hint: '我看到官案和人物模型', id: 'main-hall' },
  { hint: '我在兩側展廳、看到旗幟', id: 'side-offices' },
  { hint: '我看到戰船模型', id: 'exhibits' },
  { hint: '我在後院大樹旁', id: 'kapok-tree' },
];
---
<Layout title="室內地圖" description="清金門鎮總兵署互動室內平面圖，標註頭門、大堂、川堂、內署、後院木棉等 9 個點位與參觀動線。" active="/map/">
  <PageHeader eyebrow="室內地圖" crumb="室內地圖"
    title="互動室內平面圖"
    intro="點選任意編號，檢視這裡原來做什麼、最值得注意什麼、建議停留多久，以及下一站往哪裡走。" />

  <div class="container-page py-12">
    <div class="grid gap-8 lg:grid-cols-2">
      <!-- SVG 平面圖 -->
      <div class="card p-4 sm:p-6">
        <svg viewBox="0 0 300 520" class="w-full" role="img" aria-label="總兵署平面示意圖">
          <!-- 外牆 -->
          <rect x="20" y="20" width="260" height="480" rx="6" fill="#efe6d3" stroke="#d8ccb8" stroke-width="2"/>
          <!-- 中軸 -->
          <line x1="150" y1="40" x2="150" y2="490" stroke="#d8ccb8" stroke-width="1" stroke-dasharray="4 4"/>
          <!-- 廳堂色塊 -->
          <rect x="105" y="440" width="90" height="55" rx="4" fill="#e7d2ca"/>
          <rect x="30" y="290" width="70" height="80" rx="4" fill="#eee2d0"/>
          <rect x="200" y="290" width="70" height="80" rx="4" fill="#eee2d0"/>
          <rect x="105" y="290" width="90" height="60" rx="4" fill="#e7d2ca"/>
          <rect x="110" y="160" width="80" height="150" rx="4" fill="#eee2d0"/>
          <g id="markers"></g>
        </svg>
        <p class="mt-3 text-center text-xs text-[var(--color-slate)]">原創示意圖，僅供辨識方向，非精確測繪比例</p>
      </div>

      <!-- 詳情面板 -->
      <div>
        <div id="detail" class="card min-h-[320px]">
          <div class="text-sm text-[var(--color-slate)]">點選左側編號或下方「我現在在哪裡」</div>
          <h3 class="mt-2 font-serif text-2xl">選擇一個點位</h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-wood-soft)]">平面圖共有 9 個點位，覆蓋從頭門到後院木棉的完整參觀動線。</p>
        </div>

        <!-- 我現在在哪裡 -->
        <div class="mt-6">
          <div class="mb-3 font-serif text-lg font-bold text-[var(--color-ink)]">我現在在哪裡？</div>
          <div class="grid gap-2 sm:grid-cols-2">
            {whereAmI.map((w) => (
              <button data-goto={w.id} class="where-btn rounded-xl border border-[var(--color-slate-line)] bg-white px-4 py-3 text-left text-sm text-[var(--color-wood-soft)] transition-colors hover:border-[var(--color-brick)]">
                {w.hint}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- 點位清單 -->
    <div class="mt-12">
      <h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">全部點位</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rooms.map((rm) => (
          <button data-goto={rm.id} class="where-btn overflow-hidden rounded-2xl bg-white text-left shadow-[var(--shadow-card)] transition-transform hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <ResponsiveImage src={rm.image} alt={rm.name} class="h-full w-full object-cover" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" maxWidth={720} />
              <span class="absolute left-3 top-3 grid h-8 w-8 place-items-center rounded-full step-num text-sm">{rm.num}</span>
            </div>
            <div class="p-4">
              <div class="font-serif font-bold text-[var(--color-ink)]">{rm.name}</div>
              <p class="mt-1 line-clamp-2 text-sm text-[var(--color-wood-soft)]">{rm.summary}</p>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <script define:vars={{ roomsJson, plan }}>
    const rooms = JSON.parse(roomsJson);
    const byId = Object.fromEntries(rooms.map((r) => [r.id, r]));
    const idx = Object.fromEntries(rooms.map((r, i) => [r.id, i]));

    // 畫標記點
    const g = document.getElementById('markers');
    const svgNS = 'http://www.w3.org/2000/svg';
    rooms.forEach((r) => {
      const p = plan[r.id];
      if (!p) return;
      const grp = document.createElementNS(svgNS, 'g');
      grp.setAttribute('class', 'marker');
      grp.setAttribute('data-goto', r.id);
      grp.style.cursor = 'pointer';
      const c = document.createElementNS(svgNS, 'circle');
      c.setAttribute('cx', p.x); c.setAttribute('cy', p.y); c.setAttribute('r', '15');
      c.setAttribute('fill', '#9a3b2e');
      const t = document.createElementNS(svgNS, 'text');
      t.setAttribute('x', p.x); t.setAttribute('y', p.y + 4);
      t.setAttribute('text-anchor', 'middle'); t.setAttribute('fill', '#f7f1e6');
      t.setAttribute('font-size', '12'); t.setAttribute('font-weight', '700');
      t.textContent = r.num;
      grp.appendChild(c); grp.appendChild(t);
      g.appendChild(grp);
    });

    const detail = document.getElementById('detail');
    function show(id) {
      const r = byId[id];
      if (!r) return;
      const next = rooms[idx[id] + 1];
      detail.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-full step-num text-lg font-bold">${r.num}</span>
          <div>
            <h3 class="font-serif text-2xl font-bold" style="color:var(--color-ink)">${r.name}</h3>
            <div class="text-xs" style="color:var(--color-slate)">建議停留約 ${r.minutes} 分鐘</div>
          </div>
        </div>
        <img src="${r.imageUrl}" srcset="${r.imageSrcSet}" sizes="(min-width: 1024px) 50vw, 100vw" width="${r.imageWidth}" height="${r.imageHeight}" alt="${r.name}" loading="lazy" decoding="async" class="mt-4 aspect-[16/9] w-full rounded-xl object-cover" />
        <p class="mt-4 text-sm leading-7" style="color:var(--color-wood-soft)">${r.summary}</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          ${r.see.map((s) => `<span class="rounded-full px-2.5 py-1 text-xs" style="background:var(--color-paper-deep);color:var(--color-wood-soft)">看點 · ${s}</span>`).join('')}
        </div>
        ${next ? `<div class="mt-4 text-sm font-medium" style="color:var(--color-brick)">下一站 → ${next.name}</div>` : `<div class="mt-4 text-sm font-medium" style="color:var(--color-brick)">參觀結束，從這裡前往出口</div>`}
      `;
      // 高亮
      document.querySelectorAll('.marker circle').forEach((el) => el.setAttribute('fill', '#9a3b2e'));
      const active = document.querySelector(`.marker[data-goto="${id}"] circle`);
      if (active) active.setAttribute('fill', '#d95f34');
      detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-goto]');
      if (el) show(el.getAttribute('data-goto'));
    });
  </script>
</Layout>
