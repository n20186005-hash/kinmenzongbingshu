---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import RatingBadge from '../../../components/RatingBadge.astro';
import WeatherModule from '../../../components/WeatherModule.astro';
import SeasonalStrategy from '../../../components/SeasonalStrategy.astro';
import DayRoutes from '../../../components/DayRoutes.astro';
import AudiencePlans from '../../../components/AudiencePlans.astro';
import VisitorServices from '../../../components/VisitorServices.astro';
import ScienceResponsibility from '../../../components/ScienceResponsibility.astro';
import { attraction, googleRating } from '../../../data/site';
import { localizedAttraction, localizedPath, type Locale } from '../../../i18n/config';
import { getLocalizedContent, type TranslatedLocale } from '../../../i18n/content';
import { getTranslatedLocalePaths } from '../../../i18n/paths';

export function getStaticPaths() {
  return getTranslatedLocalePaths();
}

const { locale } = Astro.props as { locale: TranslatedLocale };
const content = getLocalizedContent(locale);
const localAttraction = localizedAttraction[locale];
const href = (path: string) => localizedPath(locale as Locale, path);

// 搜尋結果標題需帶入品牌關鍵字（Google 地圖英文名 Troops Headquarters 一併納入）
const seo = locale === 'en'
  ? {
      title: 'Kinmen Military Headquarters: Opening Hours, Free Admission & Visit Routes',
      description: 'Kinmen Military Headquarters (Troops Headquarters) in Jincheng: free admission, open daily 09:00–22:00, plus 20/45/90-minute visit routes, live weather advice and the free 19:30 Houpu night tour.',
    }
  : {
      title: '清金门镇总兵署开放时间、门票与参观路线',
      description: '清金门镇总兵署（浯江新庄）门票免费、每日 09:00–22:00 开放，是金门少数开放到夜间的古迹。含地址、电话、20／45／90 分钟参观路线、即时天气建议与 19:30 免费后浦夜间导览。',
    };
---
<Layout title={seo.title} description={seo.description} active="/visit/">
  <PageHeader eyebrow={locale === 'en' ? 'Plan your visit' : '参观信息'} crumb={locale === 'en' ? 'Plan your visit' : '参观信息'} title={content.visit.title} intro={content.visit.intro} />
  <WeatherModule class="pt-12" />
  <SeasonalStrategy class="pt-16" />

  <div class="container-page py-12">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {content.facts.map(([label, value]) => <div class="card p-4"><div class="text-xs text-[var(--color-slate)]">{label}</div><div class="mt-1 font-bold text-[var(--color-ink)]">{value}</div></div>)}
    </div>
    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <section>
        <h2 class="text-2xl">{content.visit.basic}</h2>
        <dl class="mt-5 divide-y divide-[var(--color-slate-line)] rounded-2xl bg-white px-5 shadow-[var(--shadow-card)]">
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Name' : '名称'}</dt><dd>{content.attractionName}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Address' : '地址'}</dt><dd>{localAttraction.address}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Hours' : '开放时间'}</dt><dd>{attraction.openingHours.opens}–{attraction.openingHours.closes}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Admission' : '门票'}</dt><dd>{locale === 'en' ? 'Free' : '免费'}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Phone' : '电话'}</dt><dd>{attraction.phone}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">{locale === 'en' ? 'Postal code' : '邮政编码'}</dt><dd>{attraction.postalCode}</dd></div>
          <div class="grid grid-cols-[9rem_1fr] gap-4 py-4"><dt class="font-semibold">Google rating</dt><dd>{googleRating.value} / 5 · {googleRating.count.toLocaleString('en-US')} {locale === 'en' ? 'reviews' : '则评论'}（{locale === 'en' ? 'source: Google Maps' : '资料来源：Google 地图'}）</dd></div>
        </dl>
        <RatingBadge class="mt-5" />
      </section>
      <section>
        <h2 class="text-2xl">{content.visit.today}</h2>
        <div class="mt-5 space-y-3">{content.visit.tips.map((tip) => <p class="card py-4 text-sm leading-7 text-[var(--color-wood-soft)]">{tip}</p>)}</div>
      </section>
    </div>
  </div>
  <section id="routes" class="scroll-mt-20 bg-[var(--color-paper-deep)] py-14">
    <div class="container-page">
      <h2 class="text-3xl">{content.home.routesTitle}</h2>
      <div class="mt-7 grid gap-5 md:grid-cols-3">
        {content.routes.map((route) => (
          <a href={href(`/routes/${route.id}/`)} class="card">
            <div class="text-4xl font-black text-[var(--color-brick)]">{route.minutes}<span class="text-base"> min</span></div>
            <h3 class="mt-3 text-xl">{route.name}</h3><p class="mt-2 text-sm leading-6 text-[var(--color-wood-soft)]">{route.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <DayRoutes class="pt-16" />
  <AudiencePlans class="pt-16" />
  <VisitorServices class="pt-16" />
  <ScienceResponsibility class="pb-16 pt-16" />
</Layout>
