---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { localizedPath, localeUi, type Locale } from '../../../i18n/config';
import { getLocalizedContent, type TranslatedLocale } from '../../../i18n/content';
import { getTranslatedLocalePaths } from '../../../i18n/paths';

type RouteId = '20-minute' | '45-minute' | '90-minute';

export function getStaticPaths() {
  const routeIds: RouteId[] = ['20-minute', '45-minute', '90-minute'];
  return getTranslatedLocalePaths().flatMap(({ params, props }) => routeIds.map((route) => ({
    params: { locale: params.locale, route },
    props: { locale: props.locale, routeId: route },
  })));
}

const { locale, routeId } = Astro.props as { locale: TranslatedLocale; routeId: RouteId };
const content = getLocalizedContent(locale);
const route = content.routes.find((item) => item.id === routeId)!;
const ui = localeUi[locale];
const href = (path: string) => localizedPath(locale as Locale, path);
const stops = route.stopIds.map((id) => content.rooms.find((room) => room.id === id)!).filter(Boolean);
---
<Layout
  title={route.name}
  description={route.desc}
  active="/visit/"
  pageType="Article"
  breadcrumbs={[
    { name: ui.home, path: href('/') },
    { name: locale === 'en' ? 'Plan your visit' : '参观与路线', path: href('/visit/') },
    { name: route.name, path: href(`/routes/${route.id}/`) },
  ]}
>
  <PageHeader eyebrow={`${route.badge} · ${route.minutes} min`} crumb={locale === 'en' ? 'Timed routes' : '参观与路线'} title={route.name} intro={route.desc}>
    <div class="mt-5 flex flex-wrap gap-2">
      {content.routes.map((item) => <a href={href(`/routes/${item.id}/`)} class:list={['rounded-full px-4 py-2 text-sm font-medium', item.id === route.id ? 'bg-[var(--color-brick)] text-white' : 'border border-[var(--color-slate-line)] bg-white']}>{item.minutes} min</a>)}
    </div>
  </PageHeader>
  <div class="container-page py-12">
    <ol class="relative space-y-6 border-l-2 border-[var(--color-slate-line)] pl-7">
      {stops.map((stop, index) => (
        <li class="relative">
          <span class="absolute -left-[43px] grid h-8 w-8 place-items-center rounded-full step-num text-sm font-bold">{index + 1}</span>
          <article class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
            <div class="flex flex-col sm:flex-row">
              <ResponsiveImage src={stop.image} alt={stop.name} class="h-44 w-full object-cover sm:h-auto sm:w-56" sizes="(min-width: 640px) 224px, 100vw" maxWidth={640} />
              <div class="flex-1 p-5">
                <div class="text-xs text-[var(--color-slate)]">{locale === 'en' ? `About ${stop.minutes} minutes` : `约 ${stop.minutes} 分钟`}</div>
                <h2 class="mt-1 text-xl">{stop.name}</h2>
                <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{stop.summary}</p>
                <div class="mt-3 flex flex-wrap gap-2">{stop.see.map((item) => <span class="rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs">{item}</span>)}</div>
                {stops[index + 1] && <p class="mt-4 text-xs font-semibold text-[var(--color-brick)]">{locale === 'en' ? 'Next stop' : '下一站'} → {stops[index + 1].name}</p>}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
    <a href={href('/map/')} class="btn btn-primary mt-8">{content.home.openMap} →</a>
  </div>
</Layout>
