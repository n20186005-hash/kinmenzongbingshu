---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { getLocalizedContent, type TranslatedLocale } from '../../../i18n/content';
import { getTranslatedLocalePaths } from '../../../i18n/paths';

export function getStaticPaths() {
  return getTranslatedLocalePaths();
}

const { locale } = Astro.props as { locale: TranslatedLocale };
const content = getLocalizedContent(locale);
const plan: Record<string, { x: number; y: number }> = {
  'main-gate': { x: 150, y: 470 }, 'front-courtyard': { x: 150, y: 400 },
  'side-offices': { x: 60, y: 330 }, 'main-hall': { x: 150, y: 320 },
  'passage-hall': { x: 150, y: 250 }, 'inner-office': { x: 150, y: 190 },
  'residence': { x: 150, y: 130 }, 'exhibits': { x: 245, y: 250 },
  'kapok-tree': { x: 150, y: 60 },
};
---
<Layout title={content.map.title} description={content.map.intro} active="/map/">
  <PageHeader eyebrow={locale === 'en' ? 'Indoor map' : '室内地图'} crumb={locale === 'en' ? 'Indoor map' : '室内地图'} title={content.map.title} intro={content.map.intro} />
  <div class="container-page py-12">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <section class="card p-4 sm:p-6 lg:sticky lg:top-24">
        <svg viewBox="0 0 300 520" class="w-full" role="img" aria-label={content.map.title}>
          <rect x="20" y="20" width="260" height="480" rx="6" fill="#efe6d3" stroke="#d8ccb8" stroke-width="2"/>
          <line x1="150" y1="40" x2="150" y2="490" stroke="#d8ccb8" stroke-width="1" stroke-dasharray="4 4"/>
          <rect x="105" y="440" width="90" height="55" rx="4" fill="#e7d2ca"/>
          <rect x="30" y="290" width="70" height="80" rx="4" fill="#eee2d0"/>
          <rect x="200" y="290" width="70" height="80" rx="4" fill="#eee2d0"/>
          <rect x="105" y="290" width="90" height="60" rx="4" fill="#e7d2ca"/>
          <rect x="110" y="160" width="80" height="150" rx="4" fill="#eee2d0"/>
          {content.rooms.map((room) => {
            const point = plan[room.id];
            return <a href={`#${room.id}`} aria-label={room.name}><circle cx={point.x} cy={point.y} r="15" fill="#9a3b2e"/><text x={point.x} y={point.y + 4} text-anchor="middle" fill="#fff" font-size="12" font-weight="700">{room.num}</text></a>;
          })}
        </svg>
      </section>
      <section>
        <h2 class="text-2xl">{content.map.all}</h2>
        <div class="mt-5 space-y-5">
          {content.rooms.map((room, index) => (
            <article id={room.id} class="scroll-mt-24 overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
              <ResponsiveImage src={room.image} alt={room.name} class="aspect-[16/9] w-full object-cover" sizes="(min-width: 1024px) 50vw, 100vw" maxWidth={960} />
              <div class="p-5">
                <div class="flex items-center justify-between gap-3"><h3 class="text-xl">{room.num} · {room.name}</h3><span class="text-xs text-[var(--color-slate)]">{room.minutes} min</span></div>
                <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{room.summary}</p>
                <div class="mt-3 flex flex-wrap gap-2">{room.see.map((item) => <span class="rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs">{item}</span>)}</div>
                {content.rooms[index + 1] && <a href={`#${content.rooms[index + 1].id}`} class="mt-4 inline-flex text-sm font-semibold text-[var(--color-brick)]">{content.map.next} → {content.rooms[index + 1].name}</a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>
