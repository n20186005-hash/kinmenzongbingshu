---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { rooms } from '../../data/site';
---
<Layout title="總兵署裡面有什麼" description="清金門鎮總兵署內部空間逐間介紹：頭門、前庭、大堂、東西科房、川堂、內署、內宅、戰船展與後院木棉。" active="/map/">
  <PageHeader eyebrow="內部空間" crumb="裡面有什麼"
    title="總兵署裡面有什麼"
    intro="沿參觀動線，從頭門到後院，逐間告訴你這裡原來做什麼、重點看什麼。" />
  <div class="container-page py-12">
    <div class="space-y-6">
      {rooms.map((rm) => (
        <div id={rm.id} class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)] scroll-mt-24">
          <div class="flex flex-col md:flex-row">
            <div class="md:w-72 shrink-0">
              <ResponsiveImage src={rm.image} alt={rm.name} class="h-52 w-full object-cover md:h-full" sizes="(min-width: 768px) 288px, 100vw" maxWidth={720} />
            </div>
            <div class="flex-1 p-6">
              <div class="flex items-center gap-3">
                <span class="grid h-9 w-9 place-items-center rounded-full step-num text-sm font-bold">{rm.num}</span>
                <h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{rm.name}</h2>
                <span class="text-xs text-[var(--color-slate)]">約 {rm.minutes} 分鐘</span>
              </div>
              <p class="mt-3 leading-7 text-[var(--color-wood-soft)]">{rm.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {rm.see.map((s) => <span class="rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs text-[var(--color-wood-soft)]">看點 · {s}</span>)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/map/" class="btn btn-primary">開啟互動平面圖 →</a>
      <a href="/visit/#routes" class="btn btn-secondary">按時間選擇路線 →</a>
    </div>
  </div>
</Layout>
