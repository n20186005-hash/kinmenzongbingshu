---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { faqPageLd } from '../../lib/faq';
import { attraction, highlights, routes } from '../../data/site';

const visitFlow = [
  { step: '01', title: '先看頭門與中軸', text: '從磚紅頭門進入後先停在前庭，回頭看門樓，再沿中軸線理解清代官署的對稱格局。' },
  { step: '02', title: '大堂看軍政核心', text: '大堂是總兵公開處理軍政事務的核心空間，先看官案、匾額與人物陳設，再理解總兵職權。' },
  { step: '03', title: '科房、川堂到內署', text: '由公開辦公空間逐步走向半私密區域，可以最直觀地看懂「前衙後宅」的官署布局。' },
  { step: '04', title: '戰船與兵器展', text: '金門總兵署最重要的歷史背景是海防。看到戰船模型與兵器時，可把建築和金門水師防務連在一起理解。' },
  { step: '05', title: '後院木棉收尾', text: '後院古木與大堂同框，是參觀收尾與拍照最舒服的位置；春季木棉花期尤其值得停留。' },
];

const faqs = [
  { q: '金門總兵署導覽要安排多久？', a: '第一次來建議安排 45–60 分鐘。若只想看主要空間，可走 20 分鐘快速路線；想連歷史、建築與海防背景一起看，建議安排 90 分鐘。' },
  { q: '金門總兵署有固定白天導覽嗎？', a: '一般自由參觀不必跟團。若想參加固定時段活動，本站目前重點整理的是每日 19:30 在總兵署現場報名的「後浦美麗小鎮之旅」夜間導覽；活動仍應以官方與現場公告為準。' },
  { q: '第一次參觀最不能錯過什麼？', a: '建議至少看頭門、前庭中軸、大堂、戰船與兵器展、後院木棉五個重點。時間充裕再補看東西科房、川堂與內宅。' },
  { q: '總兵署適合帶長輩或小孩嗎？', a: '主要動線以平地院落與廊道為主，路程不長。親子可把重點放在戰船模型與人物場景；長輩則可用 45 分鐘路線慢慢走。' },
  { q: '參觀完總兵署下一站去哪裡？', a: '最順的走法是接邱良功母節孝坊、浯江書院、奎閣、城隍廟與模範街；如果傍晚到訪，可先吃飯，再回總兵署參加 19:30 後浦夜遊。' },
];

const faqLd = faqPageLd(faqs);
---
<Layout
  title="金門總兵署導覽攻略｜第一次參觀怎麼看、20／45／90 分鐘路線"
  description="金門總兵署導覽攻略：第一次參觀清金門鎮總兵署該看什麼？整理頭門、大堂、科房、戰船展與後院木棉等重點，並提供 20／45／90 分鐘導覽路線、夜間導覽與周邊順遊建議。"
  active="/guide/"
  pageType="Article"
  structuredData={faqLd}
>
  <PageHeader
    eyebrow="金門總兵署導覽"
    crumb="導覽攻略"
    title="第一次來總兵署，照這條線看最清楚"
    intro="這一頁不是再重複開放時間，而是把「進去以後怎麼看」整理成一條實用導覽線：先看官署格局，再理解軍政與海防，最後從後院接到後浦老街。"
  >
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="/routes/45-minute/" class="btn btn-primary">走 45 分鐘標準路線</a>
      <a href="/map/" class="btn btn-secondary">先看室內地圖</a>
      <a href="/visit/" class="btn btn-secondary">查開放時間與門票</a>
    </div>
  </PageHeader>

  <div class="container-page py-12">
    <section>
      <p class="eyebrow">第一次參觀</p>
      <h2 class="mt-2 text-3xl">5 步看懂清金門鎮總兵署</h2>
      <div class="mt-7 grid gap-5 lg:grid-cols-5">
        {visitFlow.map((item) => (
          <article class="card">
            <div class="font-serif text-3xl font-black text-[var(--color-brick)]">{item.step}</div>
            <h3 class="mt-3 font-serif text-lg font-bold text-[var(--color-ink)]">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <p class="eyebrow">現場重點</p>
      <h2 class="mt-2 text-3xl">5 個最值得停下來看的位置</h2>
      <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {highlights.map((h, i) => (
          <article class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
            <ResponsiveImage src={h.image} alt={`${h.name}｜金門總兵署導覽重點`} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" maxWidth={720} />
            <div class="p-5">
              <div class="text-xs font-semibold text-[var(--color-brick)]">重點 {i + 1}</div>
              <h3 class="mt-1 font-serif text-xl font-bold text-[var(--color-ink)]">{h.name}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{h.note}</p>
            </div>
          </article>
        ))}
        <a href="/highlights/" class="flex min-h-48 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-[var(--color-slate-line)] p-6 text-center hover:border-[var(--color-brick)]">
          <span class="font-serif text-lg font-bold text-[var(--color-brick)]">看完整重點解析</span>
          <span class="mt-2 text-sm text-[var(--color-wood-soft)]">含更多建築與展示細節 →</span>
        </a>
      </div>
    </section>

    <section class="mt-16 rounded-3xl bg-[var(--color-paper-deep)] p-6 sm:p-9">
      <p class="eyebrow">按時間選路線</p>
      <h2 class="mt-2 text-3xl">20、45、90 分鐘怎麼選</h2>
      <div class="mt-7 grid gap-5 lg:grid-cols-3">
        {routes.map((r) => (
          <a href={`/routes/${r.id}/`} class="card group flex flex-col">
            <div class="font-serif text-4xl font-black text-[var(--color-brick)]">{r.minutes}<span class="text-lg"> 分鐘</span></div>
            <h3 class="mt-3 font-serif text-xl font-bold text-[var(--color-ink)]">{r.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-7 text-[var(--color-wood-soft)]">{r.desc}</p>
            <span class="mt-4 text-sm font-semibold text-[var(--color-brick)] group-hover:underline">查看逐站導覽 →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 grid gap-6 lg:grid-cols-2">
      <div class="card">
        <p class="eyebrow">白天</p>
        <h2 class="mt-2 font-serif text-2xl font-bold text-[var(--color-ink)]">自由參觀：先看官署，再走後浦</h2>
        <p class="mt-4 leading-8 text-[var(--color-wood-soft)]">白天建議把總兵署當作金城後浦步行的起點。參觀後可接邱良功母節孝坊、浯江書院、奎閣與模範街，景點彼此距離短，適合用步行串成半日行程。</p>
        <a href="/nearby/houpu-old-street/" class="mt-5 inline-block text-sm font-semibold text-[var(--color-brick)] hover:underline">後浦老街深度路線 →</a>
      </div>
      <div class="card">
        <p class="eyebrow">晚上</p>
        <h2 class="mt-2 font-serif text-2xl font-bold text-[var(--color-ink)]">19:30 後浦夜間導覽</h2>
        <p class="mt-4 leading-8 text-[var(--color-wood-soft)]">想有人帶著看後浦，可銜接每日 19:30 在總兵署現場報名的「後浦美麗小鎮之旅」。它和署內自由參觀是不同體驗：前者重點在後浦聚落與沿途古蹟。</p>
        <a href="/houpu-night-walk/" class="mt-5 inline-block text-sm font-semibold text-[var(--color-brick)] hover:underline">查看夜間導覽集合、路線與注意事項 →</a>
      </div>
    </section>

    <section class="mt-16 rounded-2xl border border-[var(--color-slate-line)] bg-white p-6">
      <h2 class="font-serif text-2xl font-bold text-[var(--color-ink)]">出發前先確認</h2>
      <p class="mt-3 text-sm leading-7 text-[var(--color-wood-soft)]">地址：{attraction.address}。開放時間、臨時休館與活動安排可能調整，請以官方與現場公告為準。本頁重點是協助你安排「參觀順序」，最新基本資訊請回到參觀資訊頁查看。</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/visit/" class="btn btn-primary">開放時間與門票</a>
        <a href={attraction.googleMapsUrl} target="_blank" rel="noopener" class="btn btn-secondary">Google 地圖導航 ↗</a>
      </div>
    </section>
  </div>

  <FaqBlock items={faqs} eyebrow="導覽常見問題" heading="第一次參觀最常問的 5 件事" id="guide-faq" class="pb-16" />
</Layout>
