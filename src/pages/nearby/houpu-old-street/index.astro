---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { getLocalImage } from '../../../lib/images';

const stops = [
  { name: '清金門鎮總兵署', img: 'exterior2.jpg', min: 45,
    note: '深度路線的起點。清代金門海防軍政中心，先在署內走完四進院落，再出發探索後浦老街。' },
  { name: '邱良功母節孝坊', img: 'spot-arch.jpg', min: 10, href: '/nearby/memorial-arch/',
    note: '國定古蹟，清代旌表邱良功之母的石造牌坊，雕工精細，是後浦最具代表性的牌坊。' },
  { name: '將軍第', img: 'spot-general.jpg', min: 10, href: '/nearby/general-residence/',
    note: '清代宅第，閩南官宅建築的代表，紅磚大厝格局完整，就在總兵署附近。' },
  { name: '浯江書院', img: 'spot-academy.jpg', min: 15, href: '/nearby/wujiang-academy/',
    note: '後浦的文教中心，奉祀朱熹，是瞭解金門科舉與文風的重要一站。' },
  { name: '奎閣', img: 'spot-kuige.jpg', min: 10, href: '/nearby/kuige/',
    note: '供奉魁星的六角樓閣，造型獨特，是舊時文人祈求功名之地。' },
  { name: '浯島城隍廟', img: 'spot-city-god-temple.jpg', min: 15, href: '/nearby/city-god-temple/',
    note: '後浦的信仰中心，香火鼎盛，農曆四月十二的城隍出巡是金門年度盛事。' },
  { name: '模範街', img: 'model-street.jpg', min: 30, href: '/nearby/model-street/',
    note: '紅磚連廊式老街，後浦最上鏡的街景，適合逛街、拍照與喝杯豆花收尾。' },
];
const heroImage = getLocalImage('historic.jpg');
---
<Layout title="後浦老街深度路線" description="後浦老街深度步行路線：從清金門鎮總兵署出發，串聯邱良功母節孝坊、將軍第、浯江書院、奎閣、城隍廟到模範街，約 2 小時走完金城後浦精華。" active="/nearby/" preloadImage={heroImage} preloadSizes="100vw">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <ResponsiveImage src={heroImage} alt="後浦老街" class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/85 via-[var(--color-ink)]/50 to-[var(--color-ink)]/35"></div>
    </div>
    <div class="container-page relative py-16 sm:py-20">
      <nav class="mb-3 text-xs text-white/70">
        <a href="/" class="hover:text-white">首頁</a> / <a href="/nearby/" class="hover:text-white">周邊順遊</a> / 後浦老街深度路線
      </nav>
      <p class="eyebrow text-[var(--color-paper)]/90">周邊順遊 · 深度步行</p>
      <h1 class="mt-3 font-serif text-3xl font-black text-white sm:text-5xl">後浦老街深度路線</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">
        以總兵署為起點，把後浦老城區的古蹟、書院、廟宇、牌坊與老街一次走完。
        全程平地步行，約 2 小時，是認識金城後浦的最佳路線。
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-sm text-white">
        <span class="rounded-full bg-white/15 px-4 py-2">共 {stops.length} 站</span>
        <span class="rounded-full bg-white/15 px-4 py-2">約 2 小時</span>
        <span class="rounded-full bg-white/15 px-4 py-2">全程免費</span>
      </div>
    </div>
  </section>

  <div class="container-page py-12">
    <p class="mb-8 max-w-2xl text-sm leading-7 text-[var(--color-wood-soft)]">
      建議上午或下午出發，避開正午日曬；沿途可穿插
      <a class="text-[var(--color-brick)] underline" href="/nearby/food/">附近美食</a>，
      傍晚走到模範街剛好可以銜接 19:30 的
      <a class="text-[var(--color-brick)] underline" href="/houpu-night-walk/">後浦夜遊</a>。
    </p>

    <!-- 逐站時間線 -->
    <ol class="relative space-y-6 border-l-2 border-[var(--color-slate-line)] pl-6 sm:pl-8">
      {stops.map((s, i) => (
        <li class="relative">
          <span class="absolute -left-[34px] sm:-left-[42px] grid h-8 w-8 place-items-center rounded-full step-num text-sm font-bold">{i + 1}</span>
          <div class="overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
            <div class="flex flex-col sm:flex-row">
              {s.img ? (
                <div class="sm:w-56 shrink-0">
                  <ResponsiveImage src={s.img} alt={s.name} class="h-44 w-full object-cover sm:h-full" sizes="(min-width: 640px) 224px, 100vw" maxWidth={640} />
                </div>
              ) : (
                <div class="flex sm:w-56 shrink-0 items-center justify-center bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6">
                  <span class="font-serif text-xl font-bold text-white">{s.name}</span>
                </div>
              )}
              <div class="flex-1 p-5">
                <div class="flex items-center gap-3">
                  <h3 class="font-serif text-xl font-bold text-[var(--color-ink)]">{s.name}</h3>
                  <span class="text-xs text-[var(--color-slate)]">建議 {s.min} 分鐘</span>
                </div>
                <p class="mt-2 text-sm leading-7 text-[var(--color-wood-soft)]">{s.note}</p>
                {s.href && <a href={s.href} class="mt-3 inline-block text-sm font-medium text-[var(--color-brick)] hover:underline">檢視景點詳情 →</a>}
                {i < stops.length - 1 && (
                  <div class="mt-3 text-xs font-medium text-[var(--color-brick)]">下一站 → {stops[i + 1].name}</div>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <!-- 下一步 -->
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <a href="/nearby/model-street/" class="card flex items-center justify-between transition-transform hover:-translate-y-0.5">
        <div><div class="font-bold text-[var(--color-ink)]">模範街</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">路線終點，細看紅磚老街</div></div><span class="text-[var(--color-brick)]">→</span>
      </a>
      <a href="/nearby/food/" class="card flex items-center justify-between transition-transform hover:-translate-y-0.5">
        <div><div class="font-bold text-[var(--color-ink)]">附近美食</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">沿途 7 家老店推薦</div></div><span class="text-[var(--color-brick)]">→</span>
      </a>
      <a href="/houpu-night-walk/" class="card flex items-center justify-between transition-transform hover:-translate-y-0.5">
        <div><div class="font-bold text-[var(--color-ink)]">後浦夜遊</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">19:30 現場報名</div></div><span class="text-[var(--color-brick)]">→</span>
      </a>
    </div>
  </div>
</Layout>
