---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import { getLocalImage } from '../../../lib/images';
import { food, foodByTime, foodCombos, foodTopThree } from '../../../data/site';

const gallery = [
  { img: 'food-congee.jpg', name: '廣東粥' },
  { img: 'food-youtiao.jpg', name: '油條' },
  { img: 'food-oyster.jpg', name: '蚵嗲' },
  { img: 'food-douhua.jpg', name: '豆花' },
  { img: 'food-saltycake.jpg', name: '鹹粿' },
  { img: 'food-porkrice.jpg', name: '肉燥飯' },
];
const heroImage = getLocalImage('food-street.jpg');
---
<Layout title="金門總兵署附近美食｜步行 1–6 分鐘的後浦小吃與老店" description="金門總兵署附近美食攻略：從清金門鎮總兵署步行約 1–6 分鐘，可到廣東粥、油條、鹹粿、蚵嗲、豆花等後浦老店。依早餐、午餐、晚餐與甜品整理營業時間、距離與順遊路線。" active="/nearby/" preloadImage={heroImage} preloadSizes="100vw">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <ResponsiveImage src={heroImage} alt="金門後浦模範街" class="h-full w-full object-cover" sizes="100vw" maxWidth={1600} loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)]/85 via-[var(--color-ink)]/50 to-[var(--color-ink)]/35"></div>
    </div>
    <div class="container-page relative py-16 sm:py-20">
      <nav class="mb-3 text-xs text-white/70">
        <a href="/" class="hover:text-white">首頁</a> / <a href="/nearby/" class="hover:text-white">附近</a> / 附近美食
      </nav>
      <p class="eyebrow text-[var(--color-paper)]/90">周邊順遊 · 後浦老城區</p>
      <h1 class="mt-3 max-w-2xl font-serif text-3xl font-black leading-tight text-white sm:text-5xl">金門總兵署附近美食：步行 1–6 分鐘吃什麼</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-white/90">
        清金門鎮總兵署位於後浦老城區，附近美食主要集中在莒光路一段、邱良功母節孝坊、模範街和菜市場一帶。
        想找「金門總兵署美食」不用特地搭車，大多從總兵署步行約 1–6 分鐘即可到達。
      </p>
    </div>
  </section>

  <!-- 示意圖廊 -->
  <section class="container-page mt-10">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {gallery.map((g) => (
        <div class="group relative overflow-hidden rounded-2xl shadow-[var(--shadow-card)]">
          <ResponsiveImage src={g.img} alt={g.name} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" sizes="(min-width: 768px) 33vw, 100vw" maxWidth={720} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent"></div>
          <span class="absolute bottom-2 left-3 font-serif text-lg font-bold text-white">{g.name}</span>
        </div>
      ))}
    </div>
    <p class="mt-2 text-xs text-[var(--color-slate)]">上圖為金門代表小吃示意（非特定店家），來源見<a class="underline" href="/credits/">照片版權</a>。</p>
  </section>

  <!-- 7 家 -->
  <section class="container-page mt-14">
    <p class="eyebrow">最值得推薦的 7 家</p>
    <h2 class="mt-2 text-3xl">從早餐到甜品，一條街吃完</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {food.map((f) => (
        <article class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
          {f.img ? (
            <div class="relative aspect-[16/9] overflow-hidden">
              <ResponsiveImage src={f.img} alt={`${f.name}推薦：${f.recommend}`} class="h-full w-full object-cover" sizes="(min-width: 768px) 288px, 100vw" maxWidth={720} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              <span class="absolute left-4 top-4 grid h-9 w-9 place-items-center rounded-full step-num text-sm">{f.num}</span>
              {f.illust && <span class="absolute bottom-3 right-3 rounded-full bg-black/45 px-2 py-0.5 text-[11px] text-white/90">示意圖</span>}
            </div>
          ) : (
            <div class="relative flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6 text-center">
              <span class="absolute left-4 top-4 grid h-9 w-9 place-items-center rounded-full bg-white/20 font-serif text-sm font-bold text-white">{f.num}</span>
              <span class="font-serif text-xl font-bold text-white">{f.recommend}</span>
            </div>
          )}
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-serif text-2xl font-bold text-[var(--color-ink)]">{f.name}</h3>
                <p class="mt-0.5 text-sm text-[var(--color-brick)]">{f.tagline}</p>
              </div>
              <span class="shrink-0 rounded-full bg-[var(--color-paper-deep)] px-3 py-1 text-xs text-[var(--color-wood-soft)]">{f.distance}</span>
            </div>

            <div class="mt-3 rounded-xl bg-[var(--color-paper-deep)] px-4 py-2.5 text-sm">
              <span class="text-[var(--color-slate)]">推薦 · </span>
              <span class="font-semibold text-[var(--color-wood)]">{f.recommend}</span>
            </div>

            <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-wood-soft)]">{f.desc}</p>

            <dl class="mt-4 space-y-1.5 text-sm">
              <div class="flex gap-2"><dt class="w-14 shrink-0 text-[var(--color-slate)]">營業</dt><dd class="text-[var(--color-wood)]">{f.hours}</dd></div>
              <div class="flex gap-2"><dt class="w-14 shrink-0 text-[var(--color-slate)]">地址</dt><dd class="text-[var(--color-wood)]">{f.address}</dd></div>
              <div class="flex gap-2"><dt class="w-14 shrink-0 text-[var(--color-slate)]">適合</dt><dd class="text-[var(--color-wood)]">{f.goodFor}</dd></div>
            </dl>

            <div class="mt-4 flex items-start gap-2 rounded-xl border border-[var(--color-slate-line)] bg-[var(--color-paper)] px-3 py-2.5 text-xs leading-6 text-[var(--color-wood-soft)]">
              <span class="text-[var(--color-kapok)]">提醒</span><span>{f.tip}</span>
            </div>
            {f.cash && <div class="mt-2 text-[11px] text-[var(--color-slate)]">💵 官方頁面標註以現金支付為主，建議備新臺幣現金。</div>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 按時間選擇 -->
  <section class="container-page mt-16">
    <p class="eyebrow">按時間直接選擇</p>
    <h2 class="mt-2 text-3xl">幾點到，就吃什麼</h2>
    <div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)]">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--color-slate-line)] bg-[var(--color-paper-deep)] text-left">
            <th class="p-4 font-semibold text-[var(--color-ink)]">到訪時間</th>
            <th class="p-4 font-semibold text-[var(--color-ink)]">推薦吃法</th>
          </tr>
        </thead>
        <tbody>
          {foodByTime.map(([time, rec]) => (
            <tr class="border-b border-[var(--color-slate-line)] last:border-0">
              <td class="whitespace-nowrap p-4 font-serif font-bold text-[var(--color-brick)]">{time}</td>
              <td class="p-4 text-[var(--color-wood-soft)]">{rec}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 三套組合 -->
  <section class="container-page mt-16">
    <p class="eyebrow">我最推薦的三套組合</p>
    <h2 class="mt-2 text-3xl">把景點和吃串成一條線</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {foodCombos.map((c) => (
        <div class="card flex flex-col">
          <div class="font-serif text-lg font-bold text-[var(--color-ink)]">{c.title}</div>
          <div class="mt-3 flex-1 rounded-xl bg-[var(--color-paper-deep)] p-4 text-sm leading-7 text-[var(--color-wood)]">{c.route}</div>
          <p class="mt-3 text-sm text-[var(--color-wood-soft)]">{c.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 實用提醒 + 三選 -->
  <section class="container-page mt-16">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="card lg:col-span-2">
        <h2 class="font-serif text-xl font-bold text-[var(--color-ink)]">實用提醒</h2>
        <p class="mt-3 leading-8 text-[var(--color-wood-soft)]">
          這些傳統店鋪普遍營業時間較短，部分品項賣完會提前結束。傳記、科記、永寬、蚵嗲之家和阿公ㄟ豆花的官方頁面
          目前都標註以現金支付為主，建議隨身準備新臺幣現金。想吃熱門的傳記廣東粥與和記油條，儘量早上前往。
        </p>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-[var(--color-brick)] to-[var(--color-brick-dark)] p-6 text-white">
        <div class="text-sm font-semibold text-white/80">只選三家的話</div>
        <ul class="mt-4 space-y-3">
          {foodTopThree.map((t) => (
            <li class="flex items-center gap-3">
              <span class="rounded-full bg-white/20 px-2.5 py-1 text-xs">{t.label}</span>
              <span class="font-serif text-lg font-bold">{t.name}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs leading-6 text-white/75">這三家最能覆蓋金門傳統早餐、石蚵小吃與後浦老街甜品三種體驗。</p>
      </div>
    </div>
  </section>

  <!-- 底部導航 -->
  <section class="container-page mt-14">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/nearby/" class="card flex items-center justify-between transition-transform hover:-translate-y-0.5">
        <div><div class="font-bold text-[var(--color-ink)]">附近景點</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">節孝坊、將軍第、模範街順遊</div></div><span class="text-[var(--color-brick)]">→</span>
      </a>
      <a href="/houpu-night-walk/" class="card flex items-center justify-between transition-transform hover:-translate-y-0.5">
        <div><div class="font-bold text-[var(--color-ink)]">吃完接上夜遊</div><div class="mt-1 text-sm text-[var(--color-wood-soft)]">19:30 現場報名後浦夜遊</div></div><span class="text-[var(--color-brick)]">→</span>
      </a>
    </div>
  </section>
</Layout>
