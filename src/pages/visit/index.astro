---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LocationMap from '../../components/LocationMap.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import WeatherModule from '../../components/WeatherModule.astro';
import SeasonalStrategy from '../../components/SeasonalStrategy.astro';
import DayRoutes from '../../components/DayRoutes.astro';
import AudiencePlans from '../../components/AudiencePlans.astro';
import VisitorServices from '../../components/VisitorServices.astro';
import ScienceResponsibility from '../../components/ScienceResponsibility.astro';
import { attraction, googleRating, quickFacts, nightWalk, routes } from '../../data/site';

const todayTips = [
  { range: '09:00 – 11:00', tip: '先參觀總兵署，再去金城市場或模範街，人少光線好。' },
  { range: '11:00 – 16:30', tip: '作為金城步行路線中的室內休息點，避開正午日曬。' },
  { range: '17:00 – 18:30', tip: '適合參觀後在金城老街用餐，接續夜遊。' },
  { range: '18:30 以後', tip: '重點安排 19:30 的後浦夜遊，署內亦開放至 22:00。' },
];
---
<Layout title="清金門鎮總兵署開放時間、門票與參觀路線" description="清金門鎮總兵署（浯江新莊）門票免費、每日 09:00–22:00 開放，是金門少數開放到夜間的古蹟。含地址、電話、20／45／90 分鐘參觀路線、即時天氣建議，以及 19:30 免費後浦夜間導覽安排。" active="/visit/">
  <PageHeader eyebrow="參觀資訊與路線" crumb="參觀資訊"
    title="開放時間、門票與參觀路線"
    intro="清金門鎮總兵署免費參觀，位於金城後浦核心區。這裡彙整了基本資訊、今日參觀建議，以及按時間選擇的三條參觀路線。">
    <div class="mt-5 flex flex-wrap gap-2 text-sm">
      <a href="#info" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">開放與基本資訊</a>
      <a href="#routes" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">參觀路線</a>
      <a href="/guide/" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">總兵署導覽攻略</a>
      <a href="#weather" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">即時天氣與今日建議</a>
      <a href="#day-routes" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">半日／全日路線</a>
      <a href="#services" class="rounded-full border border-[var(--color-slate-line)] bg-white px-4 py-2 text-[var(--color-wood-soft)] hover:bg-[var(--color-paper)]">訪客服務</a>
    </div>
  </PageHeader>

  <!-- 即時天氣、多日預報與可執行建議 -->
  <WeatherModule class="pt-12" />

  <!-- 四季遊覽策略 -->
  <SeasonalStrategy class="pt-16" />

  <div id="info" class="container-page py-12">
    <!-- 核心資訊卡 -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {quickFacts.map((f) => (
        <div class="card p-4">
          <div class="text-xs text-[var(--color-slate)]">{f.label}</div>
          <div class="mt-1 font-serif text-lg font-bold text-[var(--color-ink)]">{f.value}</div>
        </div>
      ))}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 prose-cn">
        <h2>基本資訊</h2>
        <table class="w-full border-collapse text-sm">
          <tbody>
            {[
              ['名稱', attraction.name],
              ['英文名稱', attraction.nameEn],
              ['地址', attraction.address],
              ['開放時間', `每日 ${attraction.openingHours.opens} – ${attraction.openingHours.closes}`],
              ['門票', attraction.admission],
              ['建議停留', attraction.suggestedMinutes],
              ['電話', `${attraction.phone}（國際 +886 82 371 717）`],
              ['郵遞區號', attraction.postalCode],
              ['Plus Code', attraction.plusCode],
              ['Google 評分', `${googleRating.value} / 5（${googleRating.count.toLocaleString('en-US')} 則評論，資料來源：Google 地圖，${googleRating.reviewedAt} 核實）`],
            ].map(([k, v]) => (
              <tr class="border-b border-[var(--color-slate-line)]">
                <th class="w-28 py-3 text-left align-top font-semibold text-[var(--color-ink)]">{k}</th>
                <td class="py-3 text-[var(--color-wood-soft)]">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>今日參觀助手</h2>
        <p>根據你到訪的時間段，給出不同的安排建議（僅依據公開時間，不顯示未經證實的即時人流）：</p>
        <div class="not-prose mt-4 space-y-3">
          {todayTips.map((t) => (
            <div class="flex gap-4 rounded-xl border border-[var(--color-slate-line)] bg-white p-4">
              <span class="w-28 shrink-0 font-serif font-bold text-[var(--color-brick)]">{t.range}</span>
              <span class="text-sm leading-6 text-[var(--color-wood-soft)]">{t.tip}</span>
            </div>
          ))}
        </div>

        <h2>夜間導覽</h2>
        <p>{nightWalk.note}</p>
      </div>

      <!-- 側欄 -->
      <aside class="space-y-5">
        <LocationMap compact />
        <RatingBadge />
        <div class="card">
          <p class="text-xs leading-6 text-[var(--color-slate)]">
            資訊可能因維修、天氣或活動臨時調整，出發前請再次確認最新公告。
          </p>
        </div>
      </aside>
    </div>
  </div>

  <!-- 參觀路線 -->
  <section id="routes" class="scroll-mt-20 border-t border-[var(--color-slate-line)] bg-[var(--color-paper-deep)] py-14">
    <div class="container-page">
      <p class="eyebrow">你有多少時間？</p>
      <h2 class="mt-2 text-3xl">選一條適合你的參觀路線</h2>
      <p class="mt-3 max-w-2xl text-[var(--color-wood-soft)]">
        不管你只有 20 分鐘順路經過，還是想花 90 分鐘深入瞭解，都為你規劃好動線與每站重點。
      </p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {routes.map((r) => (
          <a href={`/routes/${r.id}/`} class="card group flex flex-col transition-transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
              <span class="font-serif text-5xl font-black text-[var(--color-brick)]">{r.minutes}<span class="text-xl">分鐘</span></span>
              <span class="tag tag-onsite">{r.badge}</span>
            </div>
            <div class="mt-4 text-xl font-bold text-[var(--color-ink)]">{r.name}</div>
            <p class="mt-2 text-sm text-[var(--color-wood-soft)]">{r.desc}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {r.stops.slice(0, 5).map((s) => (
                <span class="rounded-full bg-[var(--color-paper)] px-2.5 py-1 text-xs text-[var(--color-wood-soft)]">{s}</span>
              ))}
              {r.stops.length > 5 && <span class="px-1 py-1 text-xs text-[var(--color-slate)]">+{r.stops.length - 5}</span>}
            </div>
            <div class="mt-5 text-sm font-medium text-[var(--color-brick)] group-hover:underline">開始這條路線 →</div>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/map/" class="btn btn-secondary">配合互動平面圖 →</a>
        <a href="/highlights/" class="btn btn-secondary">先看必看重點 →</a>
      </div>
    </div>
  </section>

  <!-- 推薦通用遊覽路線（半日／全日） -->
  <DayRoutes class="pt-16" />

  <!-- 按人群定制的遊覽方案 -->
  <AudiencePlans class="pt-16" />

  <!-- 訪客服務與周邊設施（類型中立） -->
  <VisitorServices class="pt-16" />

  <!-- 科普與訪客責任 -->
  <ScienceResponsibility class="pb-16 pt-16" />
</Layout>
